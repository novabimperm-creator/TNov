<Window x:Class="TNov.levelnumberwpf"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:TNov"
             mc:Ignorable="d" Width="300"
        d:DataContext="{d:DesignInstance local:levelnumberwpfViewModel}"
            WindowStartupLocation="CenterScreen" 
            Background="DarkSeaGreen"
            Title="TNov. Эт.Номер" ResizeMode="NoResize">
    <Window.Resources>
        <local:InverseConverter x:Key="InverseConverter"/>
    </Window.Resources>
    <StackPanel Margin="5">
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
            <TextBlock Margin="5" Text="Выберите категории для заполнения параметра:" />
        </StackPanel>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
            <CheckBox x:Name="checkBox1" IsThreeState="False" IsChecked="{Binding walls}" Content="Стены" HorizontalAlignment="Left" Width="250" Margin="5" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
            <CheckBox x:Name="checkBox2" IsThreeState="False" IsChecked="{Binding floors}" Content="Перекрытия" HorizontalAlignment="Left" Width="250" Margin="5" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
            <CheckBox x:Name="checkBox3" IsThreeState="False" IsChecked="{Binding ceilings}" Content="Потолки" HorizontalAlignment="Left" Width="250" Margin="5" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
            <CheckBox x:Name="checkBox4" IsThreeState="False" IsChecked="{Binding instances}" Content="Окна и двери" HorizontalAlignment="Left" Width="250" Margin="5" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
            <CheckBox x:Name="checkBox5" IsThreeState="False" IsChecked="{Binding rooms}" Content="Помещения" HorizontalAlignment="Left" Width="250" Margin="5" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
            <CheckBox x:Name="checkBox6" IsThreeState="False" IsChecked="{Binding park}" Content="Парковка" HorizontalAlignment="Left" Width="250" Margin="5" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
            <CheckBox x:Name="checkBox7" IsThreeState="False" IsChecked="{Binding other}" Content="Мебель, лестницы, ограждения и пр." HorizontalAlignment="Left" Width="250" Margin="5" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
            <CheckBox x:Name="checkBox8" IsThreeState="False" IsChecked="{Binding beams}" Content="Балки и перемычки" HorizontalAlignment="Left" Width="250" Margin="5" 
                      IsEnabled="{Binding checkBox8islocked, Converter={StaticResource InverseConverter}}"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
            <CheckBox x:Name="checkBox9" IsThreeState="False" IsChecked="{Binding holes}" Content="Отверстия" HorizontalAlignment="Left" Width="250" Margin="5" 
              IsEnabled="{Binding checkBox8islocked, Converter={StaticResource InverseConverter}}"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
            <Button Content="Отмена" x:Name="escButton" IsCancel="True" Click="escButton_Click" MinWidth="60" MinHeight="25" Margin="5" />
            <Button Content="Применить" x:Name="acceptButton" IsDefault="True" Click="acceptButton_Click" MinWidth="120" Margin="5"/>
        </StackPanel>
       
    </StackPanel>
    
</Window>
