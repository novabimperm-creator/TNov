<Window x:Class="TNov.roomsBackupLoad"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:TNov"
             mc:Ignorable="d" Width="280" MaxHeight="600"
        
            WindowStartupLocation="CenterScreen" 
            Background="DarkSeaGreen"
            Title="TNov" ResizeMode="NoResize">
    
    <StackPanel VerticalAlignment="Center" Margin="5">
        
            
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
            <TextBlock Margin="5" Text="Выберите резервную копию из списка" HorizontalAlignment="Center" />
            </StackPanel>
        
        
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
            <ComboBox x:Name="comboBox" MinWidth="240" Margin="5" DisplayMemberPath="FileName"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
            <Button Content="Отмена" x:Name="escButton" IsCancel="True" Click="escButton_Click" MinWidth="90" MinHeight="25" Margin="5" />
            <Button Content="Открыть" x:Name="openButton" IsDefault="True" Click="openButton_Click" MinWidth="90" MinHeight="25" Margin="5" />
            
        </StackPanel>
    </StackPanel>
    
</Window>
