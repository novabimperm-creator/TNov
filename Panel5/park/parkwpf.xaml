<Window x:Class="TNov.parkwpf"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:TNov"
             mc:Ignorable="d" Width="280"
            d:DataContext="{d:DesignInstance local:parkViewModel}"
            WindowStartupLocation="CenterScreen" 
            Background="DarkSeaGreen"
            Title="TNov. Выбор сценария" ResizeMode="NoResize">
    <StackPanel VerticalAlignment="Center" Margin="5">
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
            <TextBlock Margin="5" Text="Выберите сценарий работы:" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
            <Button Content="Нумератор" x:Name="foundnumButton" Command="{Binding Path=scenario1}" Click="acceptButton_Click" MinWidth="150" MinHeight="25" Margin="5" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
            <Button Content="Марка - Позиция" x:Name="foundnumautoButton" Command="{Binding Path=scenario2}" Click="acceptButton_Click" MinWidth="150" MinHeight="25" Margin="5" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
            <Button Content="Площади машиномест" x:Name="foundnumspecButton" Command="{Binding Path=scenario3}" Click="acceptButton_Click" MinWidth="150" MinHeight="25" Margin="5" />
        </StackPanel>
    </StackPanel>
    
</Window>
