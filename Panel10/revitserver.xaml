<Window x:Class="TNov.revitserver"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:TNov" 
        mc:Ignorable="d" Width="400"
        d:DataContext="{d:DesignInstance local:revitserverViewModel}"
            WindowStartupLocation="CenterScreen" 
            Background="DarkSeaGreen"
            Title="TNov. BIM Экспорт" ResizeMode="NoResize">
    <Window.Resources>
        <local:InverseConverter x:Key="InverseConverter"/>
    </Window.Resources>
    <StackPanel VerticalAlignment="Center" Margin="5">


        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" >

            <TreeView MinHeight="100" MaxHeight="400" Width="370" x:Name="treeView"
        BorderBrush="{x:Null}"
        BorderThickness="0"
        ItemsSource="{Binding Path=Nodes, Mode=TwoWay}"
        Margin="5">
                <TreeView.ItemTemplate>
                    <HierarchicalDataTemplate ItemsSource="{Binding Path=Children, Mode=TwoWay}">
                        <StackPanel Orientation="Horizontal">
                            <CheckBox
                    IsChecked="{Binding  IsChecked, Mode=TwoWay}"
                                IsEnabled="{Binding IsLocked, Converter={StaticResource InverseConverter}}"
                    Uid="{Binding Id}" />
                            <TextBlock Text="{Binding Text}" />
                        </StackPanel>
                    </HierarchicalDataTemplate>
                </TreeView.ItemTemplate>
            </TreeView>

        </StackPanel>



        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
            
            <Button Content="Отмена" x:Name="escButton" IsCancel="True" Click="escButton_Click" MinWidth="60" MinHeight="25" Margin="20 5 5 5" />
            <Button Content="Выбрать" x:Name="acceptButton" IsDefault="True" Click="acceptButton_Click" MinWidth="110" Margin="5"/>
        </StackPanel>

    </StackPanel>

</Window>
