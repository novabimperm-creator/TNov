<Window x:Class="TNov.AppVersionWPF"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:local="clr-namespace:TNov"
        mc:Ignorable="d"
        Width="450"
        SizeToContent="Height"
        d:DataContext="{d:DesignInstance local:AppVersionViewModel}"
        WindowStartupLocation="CenterOwner"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        WindowStyle="None">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/TNovCommon;component/Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        </ResourceDictionary>
    </Window.Resources>

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="30"
                      ResizeBorderThickness="5"
                      GlassFrameThickness="0"
                      CornerRadius="12"/>
    </WindowChrome.WindowChrome>

    <Border CornerRadius="12"
            Background="{StaticResource BgBrush}"
            BorderBrush="{StaticResource AccentBrush}"
            BorderThickness="1">
        <StackPanel Margin="18">
            <Border MouseDown="TitleBar_MouseDown" Background="Transparent" Cursor="Arrow">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="35"/>
                        <ColumnDefinition Width="35"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="НАСТРОЙКИ"
                               Grid.Column="0"
                               Foreground="{StaticResource AccentBrush}"
                               FontSize="22"
                               FontWeight="Bold"
                               VerticalAlignment="Center"/>
                    <Button Content="i"
                            Grid.Column="1"
                            HorizontalAlignment="Right"
                            Style="{StaticResource CloseButtonStyleMini}"
                            Click="HelpButton_Click"
                            WindowChrome.IsHitTestVisibleInChrome="True"/>
                    <Button Content="✕"
                            Grid.Column="2"
                            HorizontalAlignment="Right"
                            Style="{StaticResource CloseButtonStyleMini}"
                            Click="escButton_Click"
                            WindowChrome.IsHitTestVisibleInChrome="True"/>
                </Grid>
            </Border>

            <StackPanel x:Name="SettingsPanel" Margin="0,16,0,0">
                <!--<TextBlock Name="text1" Text="{Binding headtxt}" Margin="0,2,0,16"
                           Foreground="{StaticResource MutedBrush}" FontSize="12" TextWrapping="Wrap"/>-->

                <UniformGrid Columns="3">
                    <Border Style="{StaticResource InfoCardBorderStyle}" Margin="0,0,5,10">
                        <StackPanel>
                            <TextBlock Text="Имя" Style="{StaticResource InfoCardLabelStyle}"/>
                            <TextBlock Text="{Binding userName}" Style="{StaticResource InfoCardValueStyle}"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource InfoCardBorderStyle}" Margin="2.5,0,2.5,10">
                        <StackPanel>
                            <TextBlock Text="Отдел" Style="{StaticResource InfoCardLabelStyle}"/>
                            <TextBlock Text="{Binding userDep}" Style="{StaticResource InfoCardValueStyle}"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource InfoCardBorderStyle}" Margin="5,0,0,10">
                        <StackPanel>
                            <TextBlock Text="Роль" Style="{StaticResource InfoCardLabelStyle}"/>
                            <TextBlock Text="{Binding userDepRole}" Style="{StaticResource InfoCardValueStyle}"/>
                        </StackPanel>
                    </Border>
                </UniformGrid>

                <ToggleButton Style="{StaticResource CardToggleStyle}" IsChecked="{Binding extendedLogs}">
                    <StackPanel>
                        <TextBlock Text="Записывать расширенные логи" Style="{StaticResource CardTitleStyle}"/>
                        <TextBlock Text="Собирать больше данных о запусках (рекомендуется при ошибках)"
                                   Style="{StaticResource CardSubtitleStyle}"/>
                    </StackPanel>
                </ToggleButton>

                <ToggleButton Style="{StaticResource CardToggleStyle}" IsChecked="{Binding canPurge}">
                    <StackPanel>
                        <TextBlock Text="Разрешить «Удалить неиспользуемые»" Style="{StaticResource CardTitleStyle}"/>
                        <TextBlock Text="Не рекомендуется (риск удалить лишнее)"
                                   Style="{StaticResource CardSubtitleStyle}"/>
                    </StackPanel>
                </ToggleButton>

                <ToggleButton Style="{StaticResource CardToggleStyle}" IsChecked="{Binding canCreateParts}">
                    <StackPanel>
                        <TextBlock Text="Разрешить «Создать части»" Style="{StaticResource CardTitleStyle}"/>
                        <TextBlock Text="Не рекомендуется (риск случайно нажать)"
                                   Style="{StaticResource CardSubtitleStyle}"/>
                    </StackPanel>
                </ToggleButton>

                <TextBlock Text="Предупреждения о синхронизации"
                           Style="{StaticResource SectionTitleStyle}"/>

                <ComboBox Style="{StaticResource DarkComboBoxStyle}"
                          ItemsSource="{Binding synclist}"
                          SelectedItem="{Binding sync1, Mode=TwoWay}"/>

                <TextBlock Margin="0,0,0,10" TextWrapping="Wrap" HorizontalAlignment="Center">
                    <Hyperlink NavigateUri="{Binding url}"
                               RequestNavigate="Hyperlink_RequestNavigate"
                               Style="{StaticResource MutedHyperlinkStyle}">
                        Открыть инструкцию по работе функций
                    </Hyperlink>
                </TextBlock>

                <Button Content="Журнал обновлений плагина"
                        Style="{StaticResource CloseButtonStyle}"
                        Margin="0,0,0,10"
                        Click="JournalButton_Click"/>

                <Button Content="Применить"
                        Style="{StaticResource RunButtonStyle}"
                        x:Name="acceptButton"
                        IsCancel="True"
                        IsDefault="True"
                        Click="acceptButton_Click"/>
            </StackPanel>

            <Grid x:Name="JournalPanel"
                  Visibility="Collapsed"
                  Margin="0,16,0,0"
                  MinHeight="400">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0"
                      Visibility="{Binding HasReleaseEntries, Converter={StaticResource BoolToVis}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <ScrollViewer Grid.Column="0"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  MaxHeight="320">
                        <ListBox ItemsSource="{Binding ReleaseEntries}"
                                 SelectedItem="{Binding SelectedRelease, Mode=TwoWay}"
                                 Style="{StaticResource JournalListBoxStyle}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel>
                                        <TextBlock Text="{Binding ReleaseDate}" Style="{StaticResource JournalDateStyle}"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding ModuleName}"
                                                       Grid.Column="0"
                                                       Style="{StaticResource JournalModuleStyle}"/>
                                            <Border Grid.Column="1"
                                                    Style="{StaticResource AccentBadgeStyle}"
                                                    Margin="6,0,0,0">
                                                <TextBlock Text="{Binding Version}"
                                                           Style="{StaticResource JournalBadgeTextStyle}"/>
                                            </Border>
                                        </Grid>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </ScrollViewer>

                    <ScrollViewer Grid.Column="2"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  MaxHeight="320">
                        <ItemsControl ItemsSource="{Binding SelectedRelease.Changes}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource ChangeCardStyle}">
                                        <StackPanel>
                                            <Border Style="{StaticResource AccentBadgeStyle}"
                                                    HorizontalAlignment="Left"
                                                    Margin="0,0,0,6">
                                                <TextBlock Text="{Binding TypeLabel}"
                                                           Style="{StaticResource JournalBadgeTextStyle}"/>
                                            </Border>
                                            <TextBlock Text="{Binding Text}"
                                                       Style="{StaticResource JournalChangeTextStyle}"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>

                <TextBlock Grid.Row="0"
                           Text="{Binding JournalStatusMessage}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource JournalStatusStyle}">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasReleaseEntries}" Value="False">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <Button Grid.Row="1"
                        Content="Назад"
                        Style="{StaticResource CloseButtonStyle}"
                        HorizontalAlignment="Center"
                        Margin="0,10,0,0"
                        Click="BackButton_Click"/>
            </Grid>
        </StackPanel>
    </Border>
</Window>
