<Window x:Class="TNov.Mcp.Skills.SkillSaveWPF"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:local="clr-namespace:TNov.Mcp.Skills"
        mc:Ignorable="d"
        Width="520"
        SizeToContent="Height"
        d:DataContext="{d:DesignInstance local:SkillSaveModel}"
        WindowStartupLocation="CenterOwner"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        WindowStyle="None">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/TNovCommon;component/Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <Style x:Key="CardButtonStyle" TargetType="Button" BasedOn="{StaticResource CloseButtonStyle}">
                <Setter Property="Background" Value="{StaticResource BgBrush}"/>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="30" ResizeBorderThickness="5" GlassFrameThickness="0" CornerRadius="12"/>
    </WindowChrome.WindowChrome>

    <Border CornerRadius="12" Background="{StaticResource BgBrush}" BorderBrush="{StaticResource AccentBrush}" BorderThickness="1">
        <DockPanel Margin="18">
            <Border DockPanel.Dock="Top" MouseDown="TitleBar_MouseDown" Background="Transparent">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="35"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="СОХРАНИТЬ СКИЛЛ" Foreground="{StaticResource AccentBrush}"
                               FontSize="22" FontWeight="Bold" VerticalAlignment="Center"/>
                    <Button Content="✕" Grid.Column="1" HorizontalAlignment="Right"
                            Style="{StaticResource CloseButtonStyleMini}" Click="CancelButton_Click"
                            WindowChrome.IsHitTestVisibleInChrome="True"/>
                </Grid>
            </Border>

            <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
                <UniformGrid Columns="2">
                    <Button Content="Отмена" Style="{StaticResource CloseButtonStyle}" Margin="0,0,4,0"
                            IsCancel="True" Click="CancelButton_Click"/>
                    <Button Content="{Binding ConfirmText}" Style="{StaticResource RunButtonStyle}" Margin="4,0,0,0"
                            Click="ConfirmButton_Click"/>
                </UniformGrid>
            </StackPanel>

            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                          Margin="0,16,0,0" MaxHeight="660">
                <StackPanel>
                    <TextBlock Text="{Binding Title}" Style="{StaticResource InfoCardLabelStyle}" Margin="0,0,0,8"/>

                    <Border Style="{StaticResource InfoCardBorderStyle}" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="Название" Style="{StaticResource InfoCardLabelStyle}"/>
                            <TextBlock Text="{Binding Name}" Style="{StaticResource InfoCardValueStyle}" FontSize="15"
                                       FontWeight="Bold" TextWrapping="Wrap" Margin="0,2,0,2"/>
                            <TextBlock Text="{Binding AuthorText}" Style="{StaticResource InfoCardLabelStyle}" Margin="0,0,0,8"/>
                            <TextBlock Text="Описание" Style="{StaticResource InfoCardLabelStyle}"/>
                            <TextBlock Text="{Binding Description}" Style="{StaticResource InfoCardValueStyle}"
                                       TextWrapping="Wrap" Margin="0,2,0,8"/>
                            <TextBlock Text="Параметры" Style="{StaticResource InfoCardLabelStyle}"/>
                            <TextBlock Text="{Binding ParametersText}" Style="{StaticResource InfoCardValueStyle}"
                                       TextWrapping="Wrap" Margin="0,2,0,8"/>
                            <TextBlock Text="Примеры запросов" Style="{StaticResource InfoCardLabelStyle}"/>
                            <TextBlock Text="{Binding ExamplesText}" Style="{StaticResource InfoCardValueStyle}"
                                       TextWrapping="Wrap" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Инструкция и файлы — заполняет человек -->
                    <TextBlock Text="Инструкция для коллег" Style="{StaticResource SectionTitleStyle}"/>
                    <TextBox Style="{StaticResource DarkTextBoxStyle}" Text="{Binding Instruction, UpdateSourceTrigger=PropertyChanged}"
                             AcceptsReturn="True" TextWrapping="Wrap" MinHeight="70" MaxHeight="160"
                             VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top" Margin="0,0,0,4"/>
                    <TextBlock Text="Когда применять, что подготовить в модели, что проверить после. Необязательно."
                               Style="{StaticResource InfoCardLabelStyle}" TextWrapping="Wrap" Margin="0,0,0,10"/>

                    <TextBlock Text="Файлы" Style="{StaticResource SectionTitleStyle}"/>
                    <Border Style="{StaticResource InfoCardBorderStyle}" Margin="0,0,0,10">
                        <StackPanel>
                            <ItemsControl x:Name="AttachmentsList" ItemsSource="{Binding Attachments}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding}" Style="{StaticResource InfoCardValueStyle}"
                                                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center" ToolTip="{Binding}"/>
                                            <Button Grid.Column="1" Content="✕" Style="{StaticResource CloseButtonStyleMini}"
                                                    Margin="6,0,0,0" Tag="{Binding}" Click="RemoveAttachment_Click"
                                                    ToolTip="Не прикладывать"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Button Content="Прикрепить файл…" Style="{StaticResource CardButtonStyle}" Click="AddAttachment_Click"/>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="Код" Style="{StaticResource SectionTitleStyle}"/>
                    <Border Style="{StaticResource InfoCardBorderStyle}" Margin="0,0,0,10">
                        <TextBox Text="{Binding Code, Mode=OneWay}" IsReadOnly="True" Background="Transparent"
                                 BorderThickness="0" TextWrapping="NoWrap" FontFamily="Consolas" FontSize="12"
                                 Foreground="{StaticResource PrimaryTextBrush}" MaxHeight="200"
                                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"/>
                    </Border>

                    <TextBlock Text="{Binding Outcome}" Style="{StaticResource InfoCardLabelStyle}" TextWrapping="Wrap"/>
                </StackPanel>
            </ScrollViewer>
        </DockPanel>
    </Border>
</Window>
