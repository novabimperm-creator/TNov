<Window x:Class="TNov.Mcp.McpConnectorWPF"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:local="clr-namespace:TNov.Mcp"
        mc:Ignorable="d"
        Width="450"
        SizeToContent="Height"
        d:DataContext="{d:DesignInstance local:McpStatusViewModel}"
        WindowStartupLocation="CenterOwner"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        WindowStyle="None">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/TNovCommon;component/Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BoolToVis"/>
            <local:InverseBoolToVisibilityConverter x:Key="InverseBoolToVis"/>

            <!-- Ступень шкалы уровней: неактивная — карточка, достигнутая — акцент. -->
            <Style x:Key="LevelStepStyle" TargetType="Border">
                <Setter Property="Background" Value="{StaticResource CardBrush}"/>
                <Setter Property="CornerRadius" Value="10"/>
                <Setter Property="Padding" Value="10,8"/>
                <Setter Property="BorderThickness" Value="0"/>
            </Style>
            <Style x:Key="LevelNumberStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="22"/>
                <Setter Property="FontWeight" Value="Bold"/>
                <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
            </Style>
            <Style x:Key="LevelTextStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="11"/>
                <Setter Property="TextWrapping" Value="Wrap"/>
                <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
            </Style>

            <!-- Раздел нейросети: карточка, заголовок (имя и статус) раскрывает настройки подключения. -->
            <Style x:Key="SectionExpanderStyle" TargetType="Expander">
                <Setter Property="Margin" Value="0,0,0,10"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Expander">
                            <Border Background="{StaticResource CardBrush}" CornerRadius="10">
                                <DockPanel>
                                    <ToggleButton DockPanel.Dock="Top" Cursor="Hand"
                                                  Content="{TemplateBinding Header}"
                                                  IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                                        <ToggleButton.Template>
                                            <ControlTemplate TargetType="ToggleButton">
                                                <Border x:Name="HeaderBorder" Background="Transparent" CornerRadius="10" Padding="12,10">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <ContentPresenter VerticalAlignment="Center"/>
                                                        <TextBlock x:Name="Chevron" Grid.Column="1" Text="▸" FontSize="16"
                                                                   Foreground="{StaticResource MutedBrush}"
                                                                   VerticalAlignment="Center" Margin="8,0,0,0"/>
                                                    </Grid>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsChecked" Value="True">
                                                        <Setter TargetName="Chevron" Property="Text" Value="▾"/>
                                                    </Trigger>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="HeaderBorder" Property="Background" Value="{StaticResource SubtleHoverBrush}"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </ToggleButton.Template>
                                    </ToggleButton>
                                    <ContentPresenter x:Name="Body" Margin="12,0,12,12" Visibility="Collapsed"/>
                                </DockPanel>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsExpanded" Value="True">
                                    <Setter TargetName="Body" Property="Visibility" Value="Visible"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="SectionNameStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="15"/>
                <Setter Property="FontWeight" Value="Bold"/>
                <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}"/>
            </Style>

            <!-- Текст, который скрывается, когда пустой (активность коннектора). -->
            <Style x:Key="HideWhenEmptyLabelStyle" TargetType="TextBlock" BasedOn="{StaticResource InfoCardLabelStyle}">
                <Setter Property="TextWrapping" Value="Wrap"/>
                <Style.Triggers>
                    <Trigger Property="Text" Value="">
                        <Setter Property="Visibility" Value="Collapsed"/>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <!-- Вкладки окна: как карточки-переключатели TNov, текст по центру. -->
            <Style x:Key="TabRadioStyle" TargetType="RadioButton" BasedOn="{StaticResource CardRadioStyle}">
                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
            </Style>

            <!-- Кнопки внутри карточки: фон окна, чтобы не сливались с карточкой. -->
            <Style x:Key="CardButtonStyle" TargetType="Button" BasedOn="{StaticResource CloseButtonStyle}">
                <Setter Property="Background" Value="{StaticResource BgBrush}"/>
            </Style>

            <Style x:Key="CommandBoxStyle" TargetType="TextBox">
                <Setter Property="IsReadOnly" Value="True"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="TextWrapping" Value="Wrap"/>
                <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}"/>
                <Setter Property="FontFamily" Value="Consolas"/>
                <Setter Property="Margin" Value="0,2,0,8"/>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="30"
                      ResizeBorderThickness="5"
                      GlassFrameThickness="0"
                      CornerRadius="12"/>
    </WindowChrome.WindowChrome>

    <Border CornerRadius="12"
            Background="{StaticResource BgBrush}"
            BorderBrush="{StaticResource AccentBrush}"
            BorderThickness="1">
        <!-- Окно не выше рабочей области экрана (MaxHeight в коде), содержимое под заголовком прокручивается. -->
        <DockPanel Margin="18">
            <Border DockPanel.Dock="Top" MouseDown="TitleBar_MouseDown" Background="Transparent">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="35"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="НЕЙРОСЕТОШНАЯ"
                               Foreground="{StaticResource AccentBrush}"
                               FontSize="22"
                               FontWeight="Bold"
                               VerticalAlignment="Center"/>
                    <Button Content="✕"
                            Grid.Column="1"
                            HorizontalAlignment="Right"
                            Style="{StaticResource CloseButtonStyleMini}"
                            Click="CloseButton_Click"
                            WindowChrome.IsHitTestVisibleInChrome="True"/>
                </Grid>
            </Border>

            <!-- Переключатель вкладок -->
            <UniformGrid DockPanel.Dock="Top" Columns="2" Margin="0,16,0,0">
                <RadioButton x:Name="ConnectionTab" Content="Подключение" GroupName="McpTabs" IsChecked="True"
                             Style="{StaticResource TabRadioStyle}" Margin="0,0,4,0" Checked="Tab_Checked"/>
                <RadioButton x:Name="SkillsTab" Content="Скиллы" GroupName="McpTabs"
                             Style="{StaticResource TabRadioStyle}" Margin="4,0,0,0" Checked="Tab_Checked"/>
            </UniformGrid>

            <Grid>
            <ScrollViewer x:Name="ConnectionPanel" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,12,0,0">
            <StackPanel>
                <!-- Управление коннектором -->
                <UniformGrid Columns="2" Margin="0,0,0,10">
                    <Button Content="Проверить" Style="{StaticResource CloseButtonStyle}"
                            Margin="0,0,4,0" Click="CheckButton_Click"/>
                    <Button Content="{Binding ToggleText}" IsEnabled="{Binding CanToggle}"
                            Style="{StaticResource CloseButtonStyle}"
                            Margin="4,0,0,0" Click="ToggleButton_Click"/>
                </UniformGrid>

                <TextBlock Text="{Binding CheckResult}" TextWrapping="Wrap" Margin="0,0,0,10">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource InfoCardLabelStyle}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CheckResult}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <!-- Другой MCP-коннектор в Revit -->
                <Border BorderBrush="{StaticResource ElementErrorBrush}" BorderThickness="1"
                        CornerRadius="10" Padding="12,10" Margin="0,0,0,10">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding OtherMcpWarning}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock Text="{Binding OtherMcpWarning}" TextWrapping="Wrap"
                               Foreground="{StaticResource ElementErrorBrush}" FontSize="12"/>
                </Border>

                <!-- Уровень доступа -->
                <TextBlock Text="Уровень доступа" Style="{StaticResource SectionTitleStyle}"/>
                <UniformGrid Columns="3" Margin="0,0,0,6">
                    <Border Margin="0,0,4,0">
                        <Border.Style>
                            <Style TargetType="Border" BasedOn="{StaticResource LevelStepStyle}">
                                <!-- Уровень 1 есть у всех -->
                                <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
                            </Style>
                        </Border.Style>
                        <StackPanel>
                            <TextBlock Text="1" Style="{StaticResource LevelNumberStyle}" Foreground="{StaticResource DarkBrush}"/>
                            <TextBlock Text="Чтение модели" Style="{StaticResource LevelTextStyle}" Foreground="{StaticResource DarkBrush}"/>
                        </StackPanel>
                    </Border>
                    <Border Margin="2,0,2,0">
                        <Border.Style>
                            <Style TargetType="Border" BasedOn="{StaticResource LevelStepStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Level}" Value="2">
                                        <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Level}" Value="3">
                                        <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel>
                            <TextBlock Text="2"><TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource LevelNumberStyle}"><Style.Triggers><DataTrigger Binding="{Binding Level}" Value="2"><Setter Property="Foreground" Value="{StaticResource DarkBrush}"/></DataTrigger><DataTrigger Binding="{Binding Level}" Value="3"><Setter Property="Foreground" Value="{StaticResource DarkBrush}"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
                            <TextBlock Text="Параметры экземпляров"><TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource LevelTextStyle}"><Style.Triggers><DataTrigger Binding="{Binding Level}" Value="2"><Setter Property="Foreground" Value="{StaticResource DarkBrush}"/></DataTrigger><DataTrigger Binding="{Binding Level}" Value="3"><Setter Property="Foreground" Value="{StaticResource DarkBrush}"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
                        </StackPanel>
                    </Border>
                    <Border Margin="4,0,0,0">
                        <Border.Style>
                            <Style TargetType="Border" BasedOn="{StaticResource LevelStepStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Level}" Value="3">
                                        <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel>
                            <TextBlock Text="3"><TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource LevelNumberStyle}"><Style.Triggers><DataTrigger Binding="{Binding Level}" Value="3"><Setter Property="Foreground" Value="{StaticResource DarkBrush}"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
                            <TextBlock Text="Полный доступ и скрипты"><TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource LevelTextStyle}"><Style.Triggers><DataTrigger Binding="{Binding Level}" Value="3"><Setter Property="Foreground" Value="{StaticResource DarkBrush}"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
                        </StackPanel>
                    </Border>
                </UniformGrid>
                <TextBlock Text="{Binding LevelCaption}" Style="{StaticResource InfoCardLabelStyle}"
                           TextWrapping="Wrap" Margin="0,0,0,10"/>
                <StackPanel Visibility="{Binding CanChooseLevel, Converter={StaticResource BoolToVis}}" Margin="0,0,0,10">
                    <TextBlock Text="{Binding LevelChoiceLabel}" TextWrapping="Wrap" Style="{StaticResource InfoCardLabelStyle}" Margin="0,0,0,4"/>
                    <ComboBox Style="{StaticResource DarkComboBoxStyle}"
                              ItemsSource="{Binding LevelOptions}"
                              SelectedItem="{Binding SelectedLevel, Mode=TwoWay}"/>
                </StackPanel>

                <!-- Нейросети: заголовок — имя и состояние, внутри — подключение. Раскрытые разделы запоминаются. -->
                <TextBlock Text="Нейросети" Style="{StaticResource SectionTitleStyle}"/>

                <Expander Style="{StaticResource SectionExpanderStyle}" IsExpanded="{Binding Claude.IsExpanded, Mode=TwoWay}">
                    <Expander.Header>
                        <StackPanel>
                            <TextBlock Text="Claude" Style="{StaticResource SectionNameStyle}"/>
                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                <Ellipse Width="10" Height="10" Fill="{Binding Claude.StatusBrush}"
                                         VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Text="{Binding Claude.StatusText}" Style="{StaticResource InfoCardLabelStyle}" TextWrapping="Wrap"/>
                            </StackPanel>
                        </StackPanel>
                    </Expander.Header>
                    <StackPanel>
                        <TextBlock Text="{Binding Claude.Activity}" Style="{StaticResource HideWhenEmptyLabelStyle}" Margin="0,0,0,8"/>
                        <TextBlock Text="Адрес" Style="{StaticResource InfoCardLabelStyle}"/>
                        <TextBox Text="{Binding Claude.Url, Mode=OneWay}" Style="{StaticResource CommandBoxStyle}"/>
                        <TextBlock Text="«Подключить к Claude Code» прописывает мост в рабочую папку %USERPROFILE%\Claude\Revit и в настройки Claude Code. Через мост связь переживает перезапуск Revit. Права администратора не нужны. Вручную — команда ниже в PowerShell (не в чате Claude)."
                                   TextWrapping="Wrap" Style="{StaticResource InfoCardLabelStyle}"/>
                        <TextBox Text="{Binding Claude.ConnectCommand, Mode=OneWay}" Style="{StaticResource CommandBoxStyle}"/>
                        <Button Content="Подключить к Claude Code"
                                Style="{StaticResource CardButtonStyle}"
                                Margin="0,0,0,8"
                                Click="ClaudeCodeButton_Click"/>
                        <UniformGrid Columns="2">
                            <Button Content="Скопировать команду"
                                    Style="{StaticResource CardButtonStyle}"
                                    Margin="0,0,4,0"
                                    Click="CopyClaudeButton_Click"/>
                            <Button Content="Claude Desktop"
                                    ToolTip="Обычный чат Claude Desktop (без Claude Code): прописать мост в настройки приложения"
                                    Style="{StaticResource CardButtonStyle}"
                                    Margin="4,0,0,0"
                                    Click="DesktopButton_Click"/>
                        </UniformGrid>
                    </StackPanel>
                </Expander>

                <Expander Style="{StaticResource SectionExpanderStyle}" IsExpanded="{Binding Codex.IsExpanded, Mode=TwoWay}">
                    <Expander.Header>
                        <StackPanel>
                            <TextBlock Text="Codex" Style="{StaticResource SectionNameStyle}"/>
                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                <Ellipse Width="10" Height="10" Fill="{Binding Codex.StatusBrush}"
                                         VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Text="{Binding Codex.StatusText}" Style="{StaticResource InfoCardLabelStyle}" TextWrapping="Wrap"/>
                            </StackPanel>
                        </StackPanel>
                    </Expander.Header>
                    <StackPanel>
                        <TextBlock Text="{Binding Codex.Activity}" Style="{StaticResource HideWhenEmptyLabelStyle}" Margin="0,0,0,8"/>
                        <TextBlock Text="Адрес" Style="{StaticResource InfoCardLabelStyle}"/>
                        <TextBox Text="{Binding Codex.Url, Mode=OneWay}" Style="{StaticResource CommandBoxStyle}"/>
                        <TextBlock Text="«Подключить к Codex» прописывает коннектор в %USERPROFILE%\.codex\config.toml (программа для терминала, расширение IDE и приложение Codex). Права администратора не нужны. Вручную: вставьте этот блок в конец того же файла в Блокноте. Не отправляйте его в чат Codex."
                                   TextWrapping="Wrap" Style="{StaticResource InfoCardLabelStyle}"/>
                        <TextBox Text="{Binding Codex.ConnectCommand, Mode=OneWay}" Style="{StaticResource CommandBoxStyle}"/>
                        <UniformGrid Columns="2">
                            <Button Content="Скопировать блок"
                                    Style="{StaticResource CardButtonStyle}"
                                    Margin="0,0,4,0"
                                    Click="CopyCodexButton_Click"/>
                            <Button Content="Подключить к Codex"
                                    Style="{StaticResource CardButtonStyle}"
                                    Margin="4,0,0,0"
                                    Click="CodexButton_Click"/>
                        </UniformGrid>
                    </StackPanel>
                </Expander>

                <Expander Style="{StaticResource SectionExpanderStyle}" IsExpanded="{Binding Qwen.IsExpanded, Mode=TwoWay}">
                    <Expander.Header>
                        <StackPanel>
                            <TextBlock Text="Qwen" Style="{StaticResource SectionNameStyle}"/>
                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                <Ellipse Width="10" Height="10" Fill="{Binding Qwen.StatusBrush}"
                                         VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Text="{Binding Qwen.StatusText}" Style="{StaticResource InfoCardLabelStyle}" TextWrapping="Wrap"/>
                            </StackPanel>
                        </StackPanel>
                    </Expander.Header>
                    <StackPanel>
                        <TextBlock Text="{Binding Qwen.Activity}" Style="{StaticResource HideWhenEmptyLabelStyle}" Margin="0,0,0,8"/>
                        <TextBlock Text="Адрес" Style="{StaticResource InfoCardLabelStyle}"/>
                        <TextBox Text="{Binding Qwen.Url, Mode=OneWay}" Style="{StaticResource CommandBoxStyle}"/>
                        <TextBlock Text="«Подключить к Qwen Code» прописывает коннектор в %USERPROFILE%\.qwen\settings.json. Права администратора не нужны. Вручную: добавьте сервер «revit» из этого фрагмента в раздел mcpServers того же файла. Не отправляйте его в чат Qwen."
                                   TextWrapping="Wrap" Style="{StaticResource InfoCardLabelStyle}"/>
                        <TextBox Text="{Binding Qwen.ConnectCommand, Mode=OneWay}" Style="{StaticResource CommandBoxStyle}"/>
                        <UniformGrid Columns="2">
                            <Button Content="Скопировать фрагмент"
                                    Style="{StaticResource CardButtonStyle}"
                                    Margin="0,0,4,0"
                                    Click="CopyQwenButton_Click"/>
                            <Button Content="Подключить к Qwen Code"
                                    Style="{StaticResource CardButtonStyle}"
                                    Margin="4,0,0,0"
                                    Click="QwenButton_Click"/>
                        </UniformGrid>
                    </StackPanel>
                </Expander>

                <Button Content="Готово"
                        Style="{StaticResource RunButtonStyle}"
                        IsCancel="True"
                        IsDefault="True"
                        Margin="0"
                        Click="CloseButton_Click"/>

                <TextBlock Text="Нейросети работают с активным документом. Изменения отменяются Ctrl+Z."
                           Style="{StaticResource InfoCardLabelStyle}"
                           HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" Margin="0,10,0,0"/>
            </StackPanel>
            </ScrollViewer>

            <!-- Вкладка «Скиллы»: своя модель (SkillsViewModel), загрузка при первом открытии. -->
            <DockPanel x:Name="SkillsPanel" Visibility="Collapsed" Margin="0,12,0,0">
                <Button DockPanel.Dock="Bottom" Content="Готово" Style="{StaticResource RunButtonStyle}"
                        Margin="0,10,0,0" Click="CloseButton_Click"/>

                <!-- Не корпоративная конфигурация -->
                <TextBlock DockPanel.Dock="Top" Text="{Binding UnavailableText}" TextWrapping="Wrap">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource InfoCardLabelStyle}">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Available}" Value="False">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                              Visibility="{Binding Available, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Style="{StaticResource DarkTextBoxStyle}"
                                     Text="{Binding Query, UpdateSourceTrigger=PropertyChanged, Delay=400}"
                                     ToolTip="Поиск по названию, описанию и примерам запросов"/>
                            <Button Grid.Column="1" Content="Обновить" Style="{StaticResource CloseButtonStyle}"
                                    Margin="8,0,0,0" Padding="12,0" Click="SkillsRefresh_Click"/>
                        </Grid>
                        <TextBlock Text="{Binding Message}" Style="{StaticResource HideWhenEmptyLabelStyle}" Margin="0,0,0,8"/>

                        <ListBox ItemsSource="{Binding Items}" SelectedItem="{Binding Selected, Mode=TwoWay}"
                                 Style="{StaticResource JournalListBoxStyle}" MaxHeight="260"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,2">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Name}" Style="{StaticResource SectionNameStyle}" FontSize="13"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <Border Grid.Column="1" Style="{StaticResource AccentBadgeStyle}" Margin="6,0,0,0">
                                                <TextBlock Text="{Binding StatusText}" Style="{StaticResource JournalBadgeTextStyle}"/>
                                            </Border>
                                        </Grid>
                                        <TextBlock Text="{Binding ListMeta}" Style="{StaticResource InfoCardLabelStyle}" FontSize="11"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <!-- Выбранный скилл -->
                        <Border Style="{StaticResource InfoCardBorderStyle}" Margin="0,10,0,0"
                                Visibility="{Binding HasSelection, Converter={StaticResource BoolToVis}}">
                            <StackPanel>
                                <TextBlock Text="{Binding Selected.Name}" Style="{StaticResource SectionNameStyle}" TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding Selected.Author}" Style="{StaticResource InfoCardValueStyle}" Margin="0,2,0,0"/>
                                <TextBlock Text="{Binding Selected.Meta}" Style="{StaticResource InfoCardLabelStyle}" Margin="0,2,0,8"/>
                                <TextBlock Text="Описание" Style="{StaticResource InfoCardLabelStyle}"/>
                                <TextBlock Text="{Binding Selected.Description}" Style="{StaticResource InfoCardValueStyle}"
                                           TextWrapping="Wrap" Margin="0,2,0,8"/>

                                <!-- Инструкция: правят автор и отдел BIM, остальные читают -->
                                <TextBlock Text="Инструкция" Style="{StaticResource InfoCardLabelStyle}"/>
                                <TextBlock Text="{Binding Selected.Instruction}" Style="{StaticResource InfoCardValueStyle}"
                                           TextWrapping="Wrap" Margin="0,2,0,8"
                                           Visibility="{Binding Selected.ReadOnlyInstruction, Converter={StaticResource BoolToVis}}"/>
                                <StackPanel Visibility="{Binding Selected.CanEdit, Converter={StaticResource BoolToVis}}" Margin="0,2,0,8">
                                    <TextBox Style="{StaticResource DarkTextBoxStyle}"
                                             Text="{Binding InstructionDraft, UpdateSourceTrigger=PropertyChanged}"
                                             AcceptsReturn="True" TextWrapping="Wrap" MinHeight="60" MaxHeight="160"
                                             VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top"/>
                                    <Button Content="Сохранить инструкцию" Style="{StaticResource CardButtonStyle}"
                                            Margin="0,6,0,0" Click="SkillSaveInstruction_Click"/>
                                </StackPanel>

                                <!-- Файлы -->
                                <TextBlock Text="Файлы" Style="{StaticResource InfoCardLabelStyle}"/>
                                <TextBlock Text="нет" Style="{StaticResource InfoCardValueStyle}" Margin="0,2,0,4">
                                    <TextBlock.Visibility>
                                        <Binding Path="Selected.HasFiles" Converter="{StaticResource InverseBoolToVis}"/>
                                    </TextBlock.Visibility>
                                </TextBlock>
                                <ItemsControl ItemsSource="{Binding Selected.Files}" Margin="0,2,0,4">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,0,0,6">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Name}" Style="{StaticResource InfoCardValueStyle}"
                                                               TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}"/>
                                                    <TextBlock Text="{Binding Meta}" Style="{StaticResource InfoCardLabelStyle}" FontSize="11"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="6,0,0,0">
                                                    <Button Content="Открыть" Style="{StaticResource CardButtonStyle}" Padding="10,0"
                                                            Tag="{Binding Name}" Click="SkillFileOpen_Click"/>
                                                    <Button Content="Заменить" Style="{StaticResource CardButtonStyle}" Padding="10,0" Margin="4,0,0,0"
                                                            Tag="{Binding Name}" Click="SkillFileReplace_Click"
                                                            Visibility="{Binding CanEdit, Converter={StaticResource BoolToVis}}"/>
                                                    <Button Content="✕" Style="{StaticResource CloseButtonStyleMini}" Margin="4,0,0,0"
                                                            Tag="{Binding Name}" Click="SkillFileRemove_Click" ToolTip="Удалить файл"
                                                            Visibility="{Binding CanEdit, Converter={StaticResource BoolToVis}}"/>
                                                </StackPanel>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <Button Content="Прикрепить файл…" Style="{StaticResource CardButtonStyle}" Margin="0,0,0,8"
                                        Visibility="{Binding Selected.CanEdit, Converter={StaticResource BoolToVis}}"
                                        Click="SkillFileAdd_Click"/>
                                <TextBlock Text="Параметры" Style="{StaticResource InfoCardLabelStyle}"/>
                                <TextBlock Text="{Binding Selected.ParametersText}" Style="{StaticResource InfoCardValueStyle}"
                                           TextWrapping="Wrap" Margin="0,2,0,8"/>
                                <TextBlock Text="Примеры запросов" Style="{StaticResource InfoCardLabelStyle}"/>
                                <TextBlock Text="{Binding Selected.ExamplesText}" Style="{StaticResource InfoCardValueStyle}"
                                           TextWrapping="Wrap" Margin="0,2,0,8"/>
                                <TextBlock Text="Код последней версии" Style="{StaticResource InfoCardLabelStyle}"/>
                                <TextBox Text="{Binding Selected.Code, Mode=OneWay}" IsReadOnly="True" Background="Transparent"
                                         BorderThickness="0" TextWrapping="NoWrap" FontFamily="Consolas" FontSize="12"
                                         Foreground="{StaticResource PrimaryTextBrush}" MaxHeight="180" Margin="0,2,0,8"
                                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"/>
                                <UniformGrid Rows="1">
                                    <Button Content="Скопировать код" Style="{StaticResource CardButtonStyle}" Margin="0,0,4,0"
                                            Click="SkillCopy_Click"/>
                                    <Button Content="Опубликовать" Style="{StaticResource CardButtonStyle}" Margin="4,0,0,0"
                                            Visibility="{Binding Selected.CanPublish, Converter={StaticResource BoolToVis}}"
                                            Click="SkillPublish_Click"/>
                                    <Button Content="Скрыть" Style="{StaticResource CardButtonStyle}" Margin="4,0,0,0"
                                            Visibility="{Binding Selected.CanHide, Converter={StaticResource BoolToVis}}"
                                            Click="SkillHide_Click"/>
                                    <Button Content="Вернуть" Style="{StaticResource CardButtonStyle}" Margin="4,0,0,0"
                                            Visibility="{Binding Selected.CanRestore, Converter={StaticResource BoolToVis}}"
                                            Click="SkillRestore_Click"/>
                                </UniformGrid>
                            </StackPanel>
                        </Border>

                        <TextBlock Margin="0,10,0,0" TextWrapping="Wrap" Style="{StaticResource InfoCardLabelStyle}"
                                   Text="Чтобы сохранить скилл, попросите нейросеть после удачного решения: «сохрани это как скилл» — в окне сохранения можно написать инструкцию и прикрепить файлы. Уровень 2–3 публикует сразу, уровень 1 — черновиком. Инструкцию и файлы позже меняют автор и отдел BIM."/>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
            </Grid>
        </DockPanel>
    </Border>
</Window>
