<Window x:Class="TNov.Mcp.McpConnectorWPF"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:local="clr-namespace:TNov.Mcp"
        mc:Ignorable="d"
        Width="450"
        SizeToContent="Height"
        d:DataContext="{d:DesignInstance local:McpStatusViewModel}"
        WindowStartupLocation="CenterOwner"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        WindowStyle="None">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/TNovCommon;component/Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BoolToVis"/>

            <!-- Ступень шкалы уровней: неактивная — карточка, достигнутая — акцент. -->
            <Style x:Key="LevelStepStyle" TargetType="Border">
                <Setter Property="Background" Value="{StaticResource CardBrush}"/>
                <Setter Property="CornerRadius" Value="10"/>
                <Setter Property="Padding" Value="10,8"/>
                <Setter Property="BorderThickness" Value="0"/>
            </Style>
            <Style x:Key="LevelNumberStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="22"/>
                <Setter Property="FontWeight" Value="Bold"/>
                <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
            </Style>
            <Style x:Key="LevelTextStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="11"/>
                <Setter Property="TextWrapping" Value="Wrap"/>
                <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
            </Style>

            <!-- Раздел нейросети: карточка, заголовок (имя и статус) раскрывает настройки подключения. -->
            <Style x:Key="SectionExpanderStyle" TargetType="Expander">
                <Setter Property="Margin" Value="0,0,0,10"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Expander">
                            <Border Background="{StaticResource CardBrush}" CornerRadius="10">
                                <DockPanel>
                                    <ToggleButton DockPanel.Dock="Top" Cursor="Hand"
                                                  Content="{TemplateBinding Header}"
                                                  IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                                        <ToggleButton.Template>
                                            <ControlTemplate TargetType="ToggleButton">
                                                <Border x:Name="HeaderBorder" Background="Transparent" CornerRadius="10" Padding="12,10">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <ContentPresenter VerticalAlignment="Center"/>
                                                        <TextBlock x:Name="Chevron" Grid.Column="1" Text="▸" FontSize="16"
                                                                   Foreground="{StaticResource MutedBrush}"
                                                                   VerticalAlignment="Center" Margin="8,0,0,0"/>
                                                    </Grid>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsChecked" Value="True">
                                                        <Setter TargetName="Chevron" Property="Text" Value="▾"/>
                                                    </Trigger>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="HeaderBorder" Property="Background" Value="{StaticResource SubtleHoverBrush}"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </ToggleButton.Template>
                                    </ToggleButton>
                                    <ContentPresenter x:Name="Body" Margin="12,0,12,12" Visibility="Collapsed"/>
                                </DockPanel>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsExpanded" Value="True">
                                    <Setter TargetName="Body" Property="Visibility" Value="Visible"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="SectionNameStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="15"/>
                <Setter Property="FontWeight" Value="Bold"/>
                <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}"/>
            </Style>

            <!-- Текст, который скрывается, когда пустой (активность коннектора). -->
            <Style x:Key="HideWhenEmptyLabelStyle" TargetType="TextBlock" BasedOn="{StaticResource InfoCardLabelStyle}">
                <Setter Property="TextWrapping" Value="Wrap"/>
                <Style.Triggers>
                    <Trigger Property="Text" Value="">
                        <Setter Property="Visibility" Value="Collapsed"/>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <!-- Кнопки внутри карточки: фон окна, чтобы не сливались с карточкой. -->
            <Style x:Key="CardButtonStyle" TargetType="Button" BasedOn="{StaticResource CloseButtonStyle}">
                <Setter Property="Background" Value="{StaticResource BgBrush}"/>
            </Style>

            <Style x:Key="CommandBoxStyle" TargetType="TextBox">
                <Setter Property="IsReadOnly" Value="True"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="TextWrapping" Value="Wrap"/>
                <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}"/>
                <Setter Property="FontFamily" Value="Consolas"/>
                <Setter Property="Margin" Value="0,2,0,8"/>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="30"
                      ResizeBorderThickness="5"
                      GlassFrameThickness="0"
                      CornerRadius="12"/>
    </WindowChrome.WindowChrome>

    <Border CornerRadius="12"
            Background="{StaticResource BgBrush}"
            BorderBrush="{StaticResource AccentBrush}"
            BorderThickness="1">
        <!-- Окно не выше рабочей области экрана (MaxHeight в коде), содержимое под заголовком прокручивается. -->
        <DockPanel Margin="18">
            <Border DockPanel.Dock="Top" MouseDown="TitleBar_MouseDown" Background="Transparent">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="35"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="НЕЙРОСЕТОШНАЯ"
                               Foreground="{StaticResource AccentBrush}"
                               FontSize="22"
                               FontWeight="Bold"
                               VerticalAlignment="Center"/>
                    <Button Content="✕"
                            Grid.Column="1"
                            HorizontalAlignment="Right"
                            Style="{StaticResource CloseButtonStyleMini}"
                            Click="CloseButton_Click"
                            WindowChrome.IsHitTestVisibleInChrome="True"/>
                </Grid>
            </Border>

            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,16,0,0">
            <StackPanel>
                <!-- Управление коннектором -->
                <UniformGrid Columns="2" Margin="0,0,0,10">
                    <Button Content="Проверить" Style="{StaticResource CloseButtonStyle}"
                            Margin="0,0,4,0" Click="CheckButton_Click"/>
                    <Button Content="{Binding ToggleText}" IsEnabled="{Binding CanToggle}"
                            Style="{StaticResource CloseButtonStyle}"
                            Margin="4,0,0,0" Click="ToggleButton_Click"/>
                </UniformGrid>

                <TextBlock Text="{Binding CheckResult}" TextWrapping="Wrap" Margin="0,0,0,10">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource InfoCardLabelStyle}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CheckResult}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <!-- Другой MCP-коннектор в Revit -->
                <Border BorderBrush="{StaticResource ElementErrorBrush}" BorderThickness="1"
                        CornerRadius="10" Padding="12,10" Margin="0,0,0,10">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding OtherMcpWarning}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock Text="{Binding OtherMcpWarning}" TextWrapping="Wrap"
                               Foreground="{StaticResource ElementErrorBrush}" FontSize="12"/>
                </Border>

                <!-- Уровень доступа -->
                <TextBlock Text="Уровень доступа" Style="{StaticResource SectionTitleStyle}"/>
                <UniformGrid Columns="3" Margin="0,0,0,6">
                    <Border Margin="0,0,4,0">
                        <Border.Style>
                            <Style TargetType="Border" BasedOn="{StaticResource LevelStepStyle}">
                                <!-- Уровень 1 есть у всех -->
                                <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
                            </Style>
                        </Border.Style>
                        <StackPanel>
                            <TextBlock Text="1" Style="{StaticResource LevelNumberStyle}" Foreground="{StaticResource DarkBrush}"/>
                            <TextBlock Text="Чтение модели" Style="{StaticResource LevelTextStyle}" Foreground="{StaticResource DarkBrush}"/>
                        </StackPanel>
                    </Border>
                    <Border Margin="2,0,2,0">
                        <Border.Style>
                            <Style TargetType="Border" BasedOn="{StaticResource LevelStepStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Level}" Value="2">
                                        <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Level}" Value="3">
                                        <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel>
                            <TextBlock Text="2"><TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource LevelNumberStyle}"><Style.Triggers><DataTrigger Binding="{Binding Level}" Value="2"><Setter Property="Foreground" Value="{StaticResource DarkBrush}"/></DataTrigger><DataTrigger Binding="{Binding Level}" Value="3"><Setter Property="Foreground" Value="{StaticResource DarkBrush}"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
                            <TextBlock Text="Параметры экземпляров"><TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource LevelTextStyle}"><Style.Triggers><DataTrigger Binding="{Binding Level}" Value="2"><Setter Property="Foreground" Value="{StaticResource DarkBrush}"/></DataTrigger><DataTrigger Binding="{Binding Level}" Value="3"><Setter Property="Foreground" Value="{StaticResource DarkBrush}"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
                        </StackPanel>
                    </Border>
                    <Border Margin="4,0,0,0">
                        <Border.Style>
                            <Style TargetType="Border" BasedOn="{StaticResource LevelStepStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Level}" Value="3">
                                        <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel>
                            <TextBlock Text="3"><TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource LevelNumberStyle}"><Style.Triggers><DataTrigger Binding="{Binding Level}" Value="3"><Setter Property="Foreground" Value="{StaticResource DarkBrush}"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
                            <TextBlock Text="Полный доступ и скрипты"><TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource LevelTextStyle}"><Style.Triggers><DataTrigger Binding="{Binding Level}" Value="3"><Setter Property="Foreground" Value="{StaticResource DarkBrush}"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
                        </StackPanel>
                    </Border>
                </UniformGrid>
                <TextBlock Text="{Binding LevelCaption}" Style="{StaticResource InfoCardLabelStyle}"
                           TextWrapping="Wrap" Margin="0,0,0,10"/>
                <StackPanel Visibility="{Binding CanChooseLevel, Converter={StaticResource BoolToVis}}" Margin="0,0,0,10">
                    <TextBlock Text="{Binding LevelChoiceLabel}" TextWrapping="Wrap" Style="{StaticResource InfoCardLabelStyle}" Margin="0,0,0,4"/>
                    <ComboBox Style="{StaticResource DarkComboBoxStyle}"
                              ItemsSource="{Binding LevelOptions}"
                              SelectedItem="{Binding SelectedLevel, Mode=TwoWay}"/>
                </StackPanel>

                <!-- Нейросети: заголовок — имя и состояние, внутри — подключение. Раскрытые разделы запоминаются. -->
                <TextBlock Text="Нейросети" Style="{StaticResource SectionTitleStyle}"/>

                <Expander Style="{StaticResource SectionExpanderStyle}" IsExpanded="{Binding Claude.IsExpanded, Mode=TwoWay}">
                    <Expander.Header>
                        <StackPanel>
                            <TextBlock Text="Claude" Style="{StaticResource SectionNameStyle}"/>
                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                <Ellipse Width="10" Height="10" Fill="{Binding Claude.StatusBrush}"
                                         VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Text="{Binding Claude.StatusText}" Style="{StaticResource InfoCardLabelStyle}" TextWrapping="Wrap"/>
                            </StackPanel>
                        </StackPanel>
                    </Expander.Header>
                    <StackPanel>
                        <TextBlock Text="{Binding Claude.Activity}" Style="{StaticResource HideWhenEmptyLabelStyle}" Margin="0,0,0,8"/>
                        <TextBlock Text="Адрес" Style="{StaticResource InfoCardLabelStyle}"/>
                        <TextBox Text="{Binding Claude.Url, Mode=OneWay}" Style="{StaticResource CommandBoxStyle}"/>
                        <TextBlock Text="Claude Code — выполните в PowerShell (не в чате Claude), один раз на компьютере" TextWrapping="Wrap"
                                   Style="{StaticResource InfoCardLabelStyle}"/>
                        <TextBox Text="{Binding Claude.ConnectCommand, Mode=OneWay}" Style="{StaticResource CommandBoxStyle}"/>
                        <UniformGrid Columns="2">
                            <Button Content="Скопировать команду"
                                    Style="{StaticResource CardButtonStyle}"
                                    Margin="0,0,4,0"
                                    Click="CopyClaudeButton_Click"/>
                            <Button Content="Claude Desktop"
                                    ToolTip="Обычный чат Claude Desktop (без Claude Code): прописать мост в настройки приложения"
                                    Style="{StaticResource CardButtonStyle}"
                                    Margin="4,0,0,0"
                                    Click="DesktopButton_Click"/>
                        </UniformGrid>
                    </StackPanel>
                </Expander>

                <Expander Style="{StaticResource SectionExpanderStyle}" IsExpanded="{Binding Codex.IsExpanded, Mode=TwoWay}">
                    <Expander.Header>
                        <StackPanel>
                            <TextBlock Text="Codex" Style="{StaticResource SectionNameStyle}"/>
                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                <Ellipse Width="10" Height="10" Fill="{Binding Codex.StatusBrush}"
                                         VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Text="{Binding Codex.StatusText}" Style="{StaticResource InfoCardLabelStyle}" TextWrapping="Wrap"/>
                            </StackPanel>
                        </StackPanel>
                    </Expander.Header>
                    <StackPanel>
                        <TextBlock Text="{Binding Codex.Activity}" Style="{StaticResource HideWhenEmptyLabelStyle}" Margin="0,0,0,8"/>
                        <TextBlock Text="Адрес" Style="{StaticResource InfoCardLabelStyle}"/>
                        <TextBox Text="{Binding Codex.Url, Mode=OneWay}" Style="{StaticResource CommandBoxStyle}"/>
                        <TextBlock Text="«Подключить к Codex» прописывает коннектор в %USERPROFILE%\.codex\config.toml (программа для терминала, расширение IDE и приложение Codex). Права администратора не нужны. Вручную: вставьте этот блок в конец того же файла в Блокноте. Не отправляйте его в чат Codex."
                                   TextWrapping="Wrap" Style="{StaticResource InfoCardLabelStyle}"/>
                        <TextBox Text="{Binding Codex.ConnectCommand, Mode=OneWay}" Style="{StaticResource CommandBoxStyle}"/>
                        <UniformGrid Columns="2">
                            <Button Content="Скопировать блок"
                                    Style="{StaticResource CardButtonStyle}"
                                    Margin="0,0,4,0"
                                    Click="CopyCodexButton_Click"/>
                            <Button Content="Подключить к Codex"
                                    Style="{StaticResource CardButtonStyle}"
                                    Margin="4,0,0,0"
                                    Click="CodexButton_Click"/>
                        </UniformGrid>
                    </StackPanel>
                </Expander>

                <Expander Style="{StaticResource SectionExpanderStyle}" IsExpanded="{Binding Qwen.IsExpanded, Mode=TwoWay}">
                    <Expander.Header>
                        <StackPanel>
                            <TextBlock Text="Qwen" Style="{StaticResource SectionNameStyle}"/>
                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                <Ellipse Width="10" Height="10" Fill="{Binding Qwen.StatusBrush}"
                                         VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Text="{Binding Qwen.StatusText}" Style="{StaticResource InfoCardLabelStyle}" TextWrapping="Wrap"/>
                            </StackPanel>
                        </StackPanel>
                    </Expander.Header>
                    <StackPanel>
                        <TextBlock Text="{Binding Qwen.Activity}" Style="{StaticResource HideWhenEmptyLabelStyle}" Margin="0,0,0,8"/>
                        <TextBlock Text="Адрес" Style="{StaticResource InfoCardLabelStyle}"/>
                        <TextBox Text="{Binding Qwen.Url, Mode=OneWay}" Style="{StaticResource CommandBoxStyle}"/>
                        <TextBlock Text="«Подключить к Qwen Code» прописывает коннектор в %USERPROFILE%\.qwen\settings.json. Права администратора не нужны. Вручную: добавьте сервер «revit» из этого фрагмента в раздел mcpServers того же файла. Не отправляйте его в чат Qwen."
                                   TextWrapping="Wrap" Style="{StaticResource InfoCardLabelStyle}"/>
                        <TextBox Text="{Binding Qwen.ConnectCommand, Mode=OneWay}" Style="{StaticResource CommandBoxStyle}"/>
                        <UniformGrid Columns="2">
                            <Button Content="Скопировать фрагмент"
                                    Style="{StaticResource CardButtonStyle}"
                                    Margin="0,0,4,0"
                                    Click="CopyQwenButton_Click"/>
                            <Button Content="Подключить к Qwen Code"
                                    Style="{StaticResource CardButtonStyle}"
                                    Margin="4,0,0,0"
                                    Click="QwenButton_Click"/>
                        </UniformGrid>
                    </StackPanel>
                </Expander>

                <Button Content="Готово"
                        Style="{StaticResource RunButtonStyle}"
                        IsCancel="True"
                        IsDefault="True"
                        Margin="0"
                        Click="CloseButton_Click"/>

                <TextBlock Text="Нейросети работают с активным документом. Изменения отменяются Ctrl+Z."
                           Style="{StaticResource InfoCardLabelStyle}"
                           HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" Margin="0,10,0,0"/>
            </StackPanel>
            </ScrollViewer>
        </DockPanel>
    </Border>
</Window>
