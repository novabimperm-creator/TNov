<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <ProjectGuid>{4E83D904-2213-4B0C-A4F8-56C0CD79C49E}</ProjectGuid>
    <RootNamespace>TNov</RootNamespace>
    <AssemblyName>TNov</AssemblyName>
    <RunPostBuildEvent>OnBuildSuccess</RunPostBuildEvent>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
  </ItemGroup>

  <!-- Коннекторы MCP: мост stdio -> HTTP для Claude Desktop и Codex (ставят Mcp\ClaudeDesktopSetup и Mcp\CodexSetup). -->
  <ItemGroup>
    <EmbeddedResource Include="Mcp\Bridge\TNovMcpBridge.ps1" LogicalName="TNov.Mcp.TNovMcpBridge.ps1" />
  </ItemGroup>

  <!-- Коннектор Claude (Mcp\ScriptRunner): компилятор C# для execute_csharp.
       Только R2027 — в R2022 используется встроенный CSharpCodeProvider: Roslyn на net48
       конфликтует со старыми System.Collections.Immutable/System.Memory из папки Revit 2022. -->
  <ItemGroup Condition="'$(Configuration)' == 'R2027'">
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.14.0" />
  </ItemGroup>

  <!-- Графические ресурсы (иконки лент) -->
  <ItemGroup>
    <None Include="resources\**\*.png" Exclude="resources\dark\**" />
    <!-- Значки для тёмной темы Revit (tools\MakeDarkIcons.ps1), читает RibbonIcons -->
    <EmbeddedResource Include="resources\dark\*.png" LogicalName="TNov.Dark.%(Filename)%(Extension)" />
  </ItemGroup>

  <!-- ===== Проектные ссылки (все модули плагина) ===== -->
  <ItemGroup>
    <ProjectReference Include="..\TNovBeams\TNovBeams.csproj" Private="false" />
    <ProjectReference Include="..\TNovBIMUtils\TNovBIMUtils.csproj" Private="false" />
    <ProjectReference Include="..\TNovCommon\TNovCommon.csproj" Private="false" />
    <ProjectReference Include="..\TNovElectrical\TNovElectrical.csproj" Private="false" />
    <ProjectReference Include="..\TNovFinishing\TNovFinishing.csproj" Private="false" />
    <ProjectReference Include="..\TNovMEPSpec\TNovMEPSpec.csproj" Private="false" />
    <ProjectReference Include="..\TNovParking\TNovParking.csproj" Private="false" />
    <ProjectReference Include="..\TNovPiles\TNovPiles.csproj" Private="false" />
    <ProjectReference Include="..\TNovRooms\TNovRooms.csproj" Private="false" />
    <ProjectReference Include="..\TNovSS\TNovSS.csproj" Private="false" />
    <ProjectReference Include="..\TNovTasks\TNovTasks.csproj" Private="false" />
    <ProjectReference Include="..\TNovUtilsAR\TNovUtilsAR.csproj" Private="false" />
    <ProjectReference Include="..\TNovUtilsST\TNovUtilsST.csproj" Private="false" />
    <ProjectReference Include="..\TNovUtils\TNovUtils.csproj" Private="false" />
    <ProjectReference Include="..\TNovVent\TNovVent.csproj" Private="false" />
    <ProjectReference Include="..\TNovViewsSheets\TNovViewsSheets.csproj" Private="false" />
  </ItemGroup>

  <!-- ===== Версионирование =====
       Версия 5.гг.ММдд.минуты генерируется при сборке в obj (TNovGenerateVersionInfo в TNovDeploy\TNov.Build.props). -->
  <PropertyGroup>
    <TNovMajorVersion>5</TNovMajorVersion>
  </PropertyGroup>

  <!-- ===== Автодеплой на текущую машину (один раз, после сборки всего решения) =====
       TNov собирается последним (ссылается на все модули), поэтому деплой запускаем здесь.
       Запуск через start — отдельное окно, чтобы Console.ReadKey в TNovDeploy не блокировал сборку.
       TNovDeploy.exe собирает TNovDeploy\Setup-Workspace.ps1 (или dotnet build TNovDeploy.csproj). -->
  <PropertyGroup>
    <TNovDeployDir>$(MSBuildThisFileDirectory)..\TNovDeploy\bin\deploy</TNovDeployDir>
  </PropertyGroup>
  <Target Name="DeployToRevit" AfterTargets="Build" Condition="'$(TNovDeploy)' != 'false'">
    <Warning Condition="!Exists('$(TNovDeployDir)\TNovDeploy.exe')"
             Text="Автодеплой пропущен: нет $(TNovDeployDir)\TNovDeploy.exe — соберите TNovDeploy (Setup-Workspace.ps1)." />
    <Exec Condition="Exists('$(TNovDeployDir)\TNovDeploy.exe')"
          Command="start &quot;TNovDeploy&quot; /d &quot;$(TNovDeployDir)&quot; TNovDeploy.exe $(RevitVersion) &quot;$(OutDir.TrimEnd('\'))&quot;" />
  </Target>

</Project>
