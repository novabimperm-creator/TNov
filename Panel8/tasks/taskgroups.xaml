<Window x:Class="TNov.taskgroups"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:TNov"
             mc:Ignorable="d" Height="550" Width="650"
        SizeToContent="WidthAndHeight" MinWidth="400" MinHeight="550"
        
            WindowStartupLocation="CenterScreen" 
            Background="DarkSeaGreen"
            Title="TNov. Задания" ResizeMode="NoResize">
    <Window.Resources>
        <!-- Конвертер для видимости -->
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
    </Window.Resources>
    <StackPanel VerticalAlignment="Center" Margin="5">
        
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"/>
        <Grid Margin="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Выбор фильтра -->
            <StackPanel Orientation="Horizontal" Grid.Row="0" HorizontalAlignment="Center">
                <TextBlock Text="Фильтрация по назначению (ADSK_Группирование):" VerticalAlignment="Center" Margin="5" />
                <ComboBox x:Name="TypeComboBox" Width="150" SelectionChanged="TypeComboBox_SelectionChanged"/>
            </StackPanel>
            
            <!-- Текущий фильтр -->
            <TextBlock x:Name="CurrentFilterText" Grid.Row="2" Margin="0,5,0,5" FontWeight="Bold" Visibility="Hidden"/>

            <!-- ListView с поддержкой Drag&Drop -->
            <ListView x:Name="ItemsListView" Grid.Row="3" Height="400" HorizontalAlignment="Center" 
                  AllowDrop="False"
                  >
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="От кого" Width="70" DisplayMemberBinding="{Binding HoleGroupNamePart1}"/>
                        <GridViewColumn Header="Кому" Width="70" >
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding HoleGroupNamePart2}" 
                       TextWrapping="Wrap" 
                       VerticalAlignment="Top"/>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="Этаж" Width="70" >
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding HoleGroupNamePart3}" 
TextWrapping="Wrap" 
VerticalAlignment="Top"/>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="Статус" Width="170" >
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding HoleGroupStatus}" 
TextWrapping="Wrap" 
VerticalAlignment="Top"/>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="Действие" Width="150" >
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="{Binding ButtonText}" 
                                        Padding="5,2"
                                        Click="ItemButton_Click"
                                        Tag="{Binding}"
                                            Visibility="{Binding IsButtonVisible, Converter={StaticResource BoolToVisibility}}"
                                        ToolTip="{Binding ButtonToolTip}"/>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                    </GridView>
                </ListView.View>
                <!-- Стиль для автоматического изменения высоты строк -->
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="VerticalContentAlignment" Value="Top"/>
                        <Setter Property="Height" Value="Auto"/>
                    </Style>
                </ListView.ItemContainerStyle>
            </ListView>
        </Grid>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
            <Button Content="Закрыть" x:Name="escButton" IsCancel="True" Click="escButton_Click" MinWidth="100" MinHeight="25" Margin="5" />
        </StackPanel>
        

    </StackPanel>
    
</Window>
