<Window x:Class="TNov.typefilterwpf"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:local="clr-namespace:TNov"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        KeyDown="VisibilityFilterWPF_KeyDown" Height="480" Width="420" MinHeight="400" MinWidth="400"
        Title="TNov" WindowStyle="SingleBorderWindow"
        WindowStartupLocation="CenterScreen" Background="DarkSeaGreen"> 
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="40"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="50"/>
            <RowDefinition Height="50"/>
            <RowDefinition Height="50"/>
        </Grid.RowDefinitions>
        <DockPanel Grid.Row="0" Margin="10,8,10,4">
            <Grid>
                <TextBox TextChanged="tbSearch_TextChanged" x:Name="tbSearch" VerticalAlignment="Center" Height="24"
                 Padding="6,0" VerticalContentAlignment="Center" ToolTip="Поиск по имени типа"/>
                <TextBlock Margin="8,0,0,0" VerticalAlignment="Center" IsHitTestVisible="false"
                   FontSize="{Binding FontSize, ElementName=tbSearch}">
          <FrameworkElement.Style>
            <Style TargetType="{x:Type TextBlock}">
              <Setter Property="TextBlock.Text" Value="Поиск типов..."/>
              <Setter Property="UIElement.Visibility" Value="Collapsed"/>
              <Style.Triggers>
                <MultiDataTrigger>
                  <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding Text, ElementName=tbSearch}" Value=""/>
                    <Condition Binding="{Binding IsFocused, ElementName=tbSearch}" Value="False"/>
                  </MultiDataTrigger.Conditions>
                  <Setter Property="UIElement.Visibility" Value="Visible"/>
                </MultiDataTrigger>
              </Style.Triggers>
            </Style>
          </FrameworkElement.Style>
                </TextBlock>
            </Grid>
        </DockPanel>
        <TreeView x:Name="categoryTreeView" Grid.Row="1" Margin="10" Padding="1,5"
              VirtualizingPanel.IsVirtualizing="true" VirtualizingPanel.VirtualizationMode="Recycling">
            <FrameworkElement.Resources>
                <Style TargetType="{x:Type ContentPresenter}">
                    <Setter Property="ContentPresenter.RecognizesAccessKey" Value="false"/>
                </Style>
                <DataTemplate DataType="{x:Type local:typeFilterElementTypeViewModel}">
                    <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}">
                        <TextBlock Text="{Binding Name}"/>
                    </CheckBox>
                </DataTemplate>
                <HierarchicalDataTemplate x:Key="{DataTemplateKey {x:Type local:typeFilterCategoryViewModel}}"
                                  DataType="{x:Type local:typeFilterCategoryViewModel}" ItemsSource="{Binding ElementTypesView}">
                    <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}">
                        <TextBlock Text="{Binding Name}"/>
                    </CheckBox>
                </HierarchicalDataTemplate>
            </FrameworkElement.Resources>
        </TreeView>
        <Grid Row="2" Margin="0,0,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Button Click="btn_Hide_Click" x:Name="btn_Hide" Content="Скрыть" Margin="10,0" VerticalAlignment="Center"
              Height="25" Width="100" HorizontalAlignment="Left"/>
            <Button Click="btn_Isolate_Click" x:Name="btn_Isolate" Content="Изолировать" Margin="10,0"
              VerticalAlignment="Center" Height="25" Width="100" Grid.Column="1"/>
            <Button Click="btn_Select_Click" x:Name="btn_Select" Content="Выбрать" Margin="10,0"
              VerticalAlignment="Center" Height="25" Width="100" Grid.Column="2" HorizontalAlignment="Right"/>
        </Grid>
        <Grid Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="160"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="textBox_FilterName" Height="26" Margin="10,0" VerticalAlignment="Center"
               VerticalContentAlignment="Center" HorizontalContentAlignment="Center"/>
            <Button Click="btn_CreateFilter_Click" x:Name="btn_CreateFilter" Content="Скрыть фильтром" Margin="0"
              VerticalAlignment="Center" Width="140" Height="25" Grid.Column="1"/>
        </Grid>
        <Button Click="btn_Ok_Click" x:Name="btn_Ok" Content="Уйти" Grid.Row="4" HorizontalAlignment="Right"
            Margin="0,0,10,10" VerticalAlignment="Bottom" Width="100" Height="25"/>
    </Grid>
</Window>