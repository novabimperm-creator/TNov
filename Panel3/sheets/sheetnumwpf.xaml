<Window x:Class="TNov.sheetnumwpf"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:TNov"
             mc:Ignorable="d" Height="400" Width="400"
        SizeToContent="WidthAndHeight" MinWidth="400" MinHeight="400"
        
            WindowStartupLocation="CenterScreen" 
            Background="DarkSeaGreen"
            Title="TNov. Менеджер листов" ResizeMode="NoResize">
    
    <StackPanel VerticalAlignment="Center" Margin="5">
        
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"/>
        <Grid Margin="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Выбор фильтра -->
            <StackPanel Orientation="Horizontal" Grid.Row="0">
                <TextBlock Text="Комплект:" VerticalAlignment="Center" Margin="0,0,5,0" Width="55"/>
                <ComboBox x:Name="TypeComboBox" Width="150" SelectionChanged="TypeComboBox_SelectionChanged"/>
                <Button x:Name="ApplyFilterButton" Content="Отобразить" Margin="10,0,0,0" Click="ApplyFilterButton_Click" Width="100"/>
            </StackPanel>
            <!-- Начальный номер -->
            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,5,0,0" VerticalAlignment="Center">
                <TextBlock Text="Начальный номер:" VerticalAlignment="Center" Margin="0,0,5,0" Width="105" />
                <TextBox x:Name="StartOrderTextBox" Width="100" Height="20" VerticalAlignment="Center" Text="0"/>
                <Button x:Name="RenumberButton" Content="Обновить" Margin="10,0,0,0" Width="100"
                    Padding="5,2" Click="RenumberButton_Click"/>
            </StackPanel>
            <!-- Текущий фильтр -->
            <TextBlock x:Name="CurrentFilterText" Grid.Row="2" Margin="0,5,0,5" FontWeight="Bold" Visibility="Hidden"/>

            <!-- ListView с поддержкой Drag&Drop -->
            <ListView x:Name="ItemsListView" Grid.Row="3" Height="250" HorizontalAlignment="Center" 
                  AllowDrop="True"
                  PreviewMouseLeftButtonDown="ListView_PreviewMouseLeftButtonDown"
                  Drop="ListView_Drop"
                  DragOver="ListView_DragOver">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="Номер" Width="60" DisplayMemberBinding="{Binding TNovSheetNumericNumber}"/>
                        <GridViewColumn Header="Имя листа" Width="300" >
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding TNovSheetName}" 
                       TextWrapping="Wrap" 
                       VerticalAlignment="Top"/>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                    </GridView>
                </ListView.View>
                <!-- Стиль для автоматического изменения высоты строк -->
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="VerticalContentAlignment" Value="Top"/>
                        <Setter Property="Height" Value="Auto"/>
                    </Style>
                </ListView.ItemContainerStyle>
            </ListView>
        </Grid>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
            <Button Content="Отмена" x:Name="escButton" IsCancel="True" Click="escButton_Click" MinWidth="100" MinHeight="25" Margin="5" />
            <Button Content="Применить" IsDefault="True" Click="acceptButton_Click" MinWidth="100" Margin="5"/>
        </StackPanel>
        

    </StackPanel>
    
</Window>
