<Window x:Class="TNov.floorwpf"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:TNov"
             mc:Ignorable="d" Width="400"
            d:DataContext="{d:DesignInstance local:floorViewModel}"
            WindowStartupLocation="CenterScreen" 
            Background="DarkSeaGreen"
            Title="TNov. Генератор полов" ResizeMode="NoResize">
    <StackPanel VerticalAlignment="Center" Margin="5">
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
            <TextBlock Margin="5" Text="Тип пола:" TextWrapping="Wrap" VerticalAlignment="Center" />
            <ComboBox ItemsSource="{Binding typelist}"
        SelectedItem="{Binding Path=typename, Mode=TwoWay}"
        SelectedIndex = "0"
        Margin="5" MinWidth="316"
    />
        </StackPanel>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
            <TextBlock Name="text1" Margin="5" Text="Смещение от уровня:" TextWrapping="Wrap" />
            <TextBox Name="textBox1" Text="{Binding offset}" Margin="5" TextAlignment="Center" TextWrapping="Wrap" MinWidth="250" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
            <Button Content="Отмена" x:Name="escButton" IsCancel="True" Click="escButton_Click" MinWidth="60" MinHeight="25" Margin="5" />
            <Button Content="Запуск" x:Name="acceptButton" IsDefault="True" Click="acceptButton_Click"  MinWidth="120" MinHeight="25" Margin="5" />
        </StackPanel>
    </StackPanel>
    
</Window>
