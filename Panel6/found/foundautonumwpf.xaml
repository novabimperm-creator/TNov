<Window x:Class="TNov.foundautonumwpf"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:TNov"
             mc:Ignorable="d" Width="280"
        d:DataContext="{d:DesignInstance local:foundautonumViewModel}"
            WindowStartupLocation="CenterScreen" 
            Background="DarkSeaGreen"
            Title="TNov. Автонумерация свай" ResizeMode="NoResize">
    <StackPanel VerticalAlignment="Center" Margin="5">
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
            <TextBlock Margin="5 5 5 0" Text="Параметр:" TextWrapping="Wrap" />
            <TextBlock Margin="5 5 0 0" Text="{Binding parameterName}" FontWeight="Bold"  TextWrapping="Wrap" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
            <TextBlock Margin="5" Text="Выберите порядок нумерации:" TextWrapping="Wrap" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
            <ComboBox ItemsSource="{Binding rules}"
                SelectedItem="{Binding Path=rule, Mode=TwoWay}"
                SelectedIndex = "0"
                Margin="5 0 0 0" MinWidth="257"
            />
        </StackPanel>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0 5 0 0">
            <TextBlock Name="text1" Margin="5" Text="Начальное значение:" TextWrapping="Wrap" />
            <TextBox Name="textBox1" Text="{Binding startvalue}" MinWidth="127" Margin="5" TextAlignment="Center" TextWrapping="Wrap" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
            <CheckBox x:Name="checkBox1" IsThreeState="False" IsChecked="{Binding divide}" Content="Разделять по отметкам свай" Margin="5" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">

            <Button Content="Запуск для всех" x:Name="allButton" Command="{Binding Path=scenario1}" Click="acceptButton_Click" MinWidth="120" Margin="0 5 10 0" MinHeight="25"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="5">
            <Button Content="Отмена" x:Name="escButton" IsCancel="True" Click="escButton_Click" MinWidth="120" MinHeight="25" Margin="5" />
            <Button Content="Выбор и запуск" x:Name="selectButton" Command="{Binding Path=scenario2}" Click="acceptButton_Click"  MinWidth="120" Margin="5"/>
        </StackPanel>
    </StackPanel>
    
</Window>
