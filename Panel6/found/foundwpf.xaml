<Window x:Class="TNov.foundwpf"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:TNov"
             mc:Ignorable="d" Width="280"
            d:DataContext="{d:DesignInstance local:foundViewModel}"
            WindowStartupLocation="CenterScreen" 
            Background="DarkSeaGreen"
            Title="TNov. Выбор сценария" ResizeMode="NoResize">
    <StackPanel VerticalAlignment="Center" Margin="5">
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
            <TextBlock Margin="5" Text="Выберите сценарий работы:" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
            <Button Content="Ручной нумератор" x:Name="foundnumButton" Command="{Binding Path=scenario1}" Click="acceptButton_Click" MinWidth="150" MinHeight="25" Margin="5" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
            <Button Content="Автонумерация" x:Name="foundnumautoButton" Command="{Binding Path=scenario2}" Click="acceptButton_Click" MinWidth="150" MinHeight="25" Margin="5" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
            <Button Content="Убрать пробелы/дубли" x:Name="foundnumpurge" Command="{Binding Path=scenario3}" Click="acceptButton_Click" MinWidth="150" MinHeight="25" Margin="5" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
            <Button Content="Номера для спеки" x:Name="foundnumspecButton" Command="{Binding Path=scenario4}" Click="acceptButton_Click" MinWidth="150" MinHeight="25" Margin="5" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
            <Button Content="Заполнить отметки" x:Name="foundotmButton" Command="{Binding Path=scenario6}" Click="acceptButton_Click" MinWidth="150" MinHeight="25" Margin="5" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
            <Button Content="Вырезать фундамент" x:Name="foundcutButton" Command="{Binding Path=scenario5}" Click="acceptButton_Click" MinWidth="150" MinHeight="25" Margin="5" />
        </StackPanel>
    </StackPanel>
    
</Window>
