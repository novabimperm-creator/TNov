<Window x:Class="TNov.ssNumbererwpf"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:TNov"
             mc:Ignorable="d" Width="400"
        d:DataContext="{d:DesignInstance local:ssNumbererViewModel}"
            WindowStartupLocation="CenterScreen" 
            Background="DarkSeaGreen"
            Title="TNov. Адресатор" ResizeMode="NoResize">
    <Grid ShowGridLines="False">
        <Grid.RowDefinitions>
            <RowDefinition Height="5 px"/>
            <RowDefinition></RowDefinition>
            <RowDefinition></RowDefinition>
            <RowDefinition></RowDefinition>
            <RowDefinition></RowDefinition>
            <RowDefinition></RowDefinition>
            <RowDefinition Height="5 px"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="5 px"/>
            <ColumnDefinition></ColumnDefinition>
            <ColumnDefinition Width="5 px"/>
        </Grid.ColumnDefinitions>
        <StackPanel VerticalAlignment="Center" Margin="5" Grid.Column="1" Grid.Row="1">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                <TextBlock Margin="5" Text="Параметр:" TextWrapping="Wrap" />
                <TextBlock Margin="5" Text="Марка" FontWeight="Bold"  TextWrapping="Wrap" />
                <TextBlock Text="(системный)" TextWrapping="Wrap" VerticalAlignment="Center" />
            </StackPanel>
            
        </StackPanel>
        <StackPanel VerticalAlignment="Center" Margin="5" Grid.Column="1" Grid.Row="2">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <TextBlock Name="text1" Margin="5" Text="Номер цепи" TextWrapping="Wrap" Width="100" TextAlignment="Left" VerticalAlignment="Bottom"/>
                <TextBlock Name="text2" Margin="5" Text="Номер выхода*" TextWrapping="Wrap" Width="100" TextAlignment="Center" VerticalAlignment="Bottom"/>
                <TextBlock Name="text3" Margin="5" Text="Стартовый №" TextWrapping="Wrap" Width="100" TextAlignment="Right" VerticalAlignment="Bottom"/>
                <Button Content="v" x:Name="loadButton" Command="{Binding GetLastNumberCommand}" MinWidth="30" MinHeight="25" />
            </StackPanel>
            
        </StackPanel>
        <StackPanel VerticalAlignment="Center" Grid.Column="1" Grid.Row="3">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Height="20">
                <TextBox Name="textBox1" Text="{Binding circuitvalue}" MinWidth="110" Margin="5 0 5 0" TextAlignment="Center" TextWrapping="Wrap" />
                <TextBox Name="textBox2" Text="{Binding circuitsection}" MinWidth="110" Margin="5 0 5 0" TextAlignment="Center" TextWrapping="Wrap" />
                <TextBox Name="textBox3" Text="{Binding startvalue, Mode=TwoWay}" MinWidth="120" Margin="5 0 5 0" TextAlignment="Center" TextWrapping="Wrap" />
            </StackPanel>
        </StackPanel>
        <StackPanel VerticalAlignment="Center" Grid.Column="1" Grid.Row="4">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <TextBlock Name="text2a" Text="*может быть пустым" TextWrapping="Wrap" TextAlignment="Center" VerticalAlignment="Bottom"/>
            </StackPanel>

        </StackPanel>
        <StackPanel VerticalAlignment="Center" Margin="5" Grid.Column="1" Grid.Row="5">
            
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Button Content="Завершить" x:Name="escButton" IsCancel="True" Click="escButton_Click" MinWidth="120" MinHeight="25" Margin="5" />
                <Button Content="Старт" x:Name="acceptButton" IsDefault="True" Command="{Binding NumerateCommand}" MinWidth="120" MinHeight="25" Margin="5" />
            </StackPanel>
        </StackPanel>

    </Grid>
    
    
</Window>
