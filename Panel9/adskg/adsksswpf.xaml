<Window x:Class="TNov.adsksswpf"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:TNov"
             mc:Ignorable="d" Width="400"
        d:DataContext="{d:DesignInstance local:adskssViewModel}"
            WindowStartupLocation="CenterScreen" 
            Background="DarkSeaGreen"
            Title="TNov. Параметры ADSK" ResizeMode="NoResize">
    <StackPanel Orientation="Vertical" HorizontalAlignment="Center">
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
            <TextBlock Text="Настройки заполнения параметров" Margin="0 5 0 5" TextAlignment="Center" TextWrapping="Wrap" />
        </StackPanel>
        
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
            
            
            
            
        </StackPanel>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
            <GroupBox Header="Настройки коробов" Padding="5">
                <StackPanel Orientation="Vertical" VerticalAlignment="Center" Margin="5">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <TextBlock Text="k для кабелей" Width="120" Margin="5" TextAlignment="Right" TextWrapping="Wrap" VerticalAlignment="Center" />
                        <TextBox Text="{Binding ConduitCoeff}" Width="120" Margin="5" TextAlignment="Left" TextWrapping="Wrap" Height="25" />
                        <TextBlock Text="" Width="50" Margin="5" TextAlignment="Right" TextWrapping="Wrap" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <TextBlock Text="k для труб" Width="120" Margin="5" TextAlignment="Right" TextWrapping="Wrap" VerticalAlignment="Center" />
                        <TextBox Text="{Binding ConduitCoeffPipe}" Width="120" Margin="5" TextAlignment="Left" TextWrapping="Wrap" Height="25" />
                        <TextBlock Text="" Width="50" Margin="5" TextAlignment="Right" TextWrapping="Wrap" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <TextBlock Text="шаг крепежей" Width="120" Margin="5" TextAlignment="Right" TextWrapping="Wrap" VerticalAlignment="Center" />
                        <TextBox Text="{Binding ConduitStep}" Width="120" Margin="5" TextAlignment="Left" TextWrapping="Wrap" Height="25" />
                        <TextBlock Text="" Width="50" Margin="5" TextAlignment="Right" TextWrapping="Wrap" />
                    </StackPanel>
                </StackPanel>
            </GroupBox>


        </StackPanel>
        
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
            <GroupBox Header="Настройки цепей" Padding="5">
                <StackPanel Orientation="Vertical" VerticalAlignment="Center" Margin="5">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <TextBlock Text="k для кабелей" Width="120" Margin="5" TextAlignment="Right" TextWrapping="Wrap" VerticalAlignment="Center" />
                        <TextBox Text="{Binding ElSystemCoeffCable}" Width="120" Margin="5" TextAlignment="Left" TextWrapping="Wrap" Height="25" />
                        <TextBlock Text="" Width="50" Margin="5" TextAlignment="Right" TextWrapping="Wrap" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <TextBlock Text="k для труб" Width="120" Margin="5" TextAlignment="Right" TextWrapping="Wrap" VerticalAlignment="Center" />
                        <TextBox Text="{Binding ElSystemCoeffPipe}" Width="120" Margin="5" TextAlignment="Left" TextWrapping="Wrap" Height="25" />
                        <TextBlock Text="" Width="50" Margin="5" TextAlignment="Right" TextWrapping="Wrap" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <TextBlock Text="шаг крепежей" Width="120" Margin="5" TextAlignment="Right" TextWrapping="Wrap" VerticalAlignment="Center" />
                        <TextBox Text="{Binding ElSystemStep}" Width="120" Margin="5" TextAlignment="Left" TextWrapping="Wrap" Height="25" />
                        <TextBlock Text="" Width="50" Margin="5" TextAlignment="Right" TextWrapping="Wrap" />
                    </StackPanel>
                </StackPanel>
            </GroupBox>


        </StackPanel>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
            <GroupBox Header="Настройки лотков" Padding="5">
                <StackPanel Orientation="Vertical" VerticalAlignment="Center" Margin="5">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <TextBlock Text="k для кабелей" Width="120" Margin="5" TextAlignment="Right" TextWrapping="Wrap" VerticalAlignment="Center" />
                        <TextBox Text="{Binding CableTrayCoeffCable}" Width="120" Margin="5" TextAlignment="Left" TextWrapping="Wrap" Height="25" />
                        <TextBlock Text="" Width="50" Margin="5" TextAlignment="Right" TextWrapping="Wrap" />
                    </StackPanel>
                    
                </StackPanel>
            </GroupBox>


        </StackPanel>
        <StackPanel Orientation="Vertical" HorizontalAlignment="Center">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Button Content="Отмена" x:Name="escButton" IsCancel="True" Click="escButton_Click" Width="60" MinHeight="25" Margin="5" />
                <Button Content="Применить" x:Name="acceptButton" IsDefault="True" Click="acceptButton_Click" Width="120" Margin="5"/>
            </StackPanel>
        </StackPanel>
    </StackPanel>
    
    
</Window>
