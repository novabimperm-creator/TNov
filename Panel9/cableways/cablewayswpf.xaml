<Window x:Class="TNov.CableWaysWPF"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:TNov"
             mc:Ignorable="d" Width="800"
        d:DataContext="{d:DesignInstance local:CableWaysViewModel}"
            WindowStartupLocation="CenterScreen" 
            Background="White" BorderBrush="#FF008E43" BorderThickness="1"
            ResizeMode="NoResize" WindowStyle="None">
    <Window.Resources>
        <!-- Стиль с полным шаблоном -->
        <Style x:Key="CustomButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#F0F0F0"/>
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="BorderBrush" Value="#CCCCCC"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <!-- Убираем SystemColors -->
                        <ControlTemplate.Resources>
                            <SolidColorBrush x:Key="{x:Static SystemColors.ControlBrushKey}" 
                                         Color="Transparent"/>
                            <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" 
                                         Color="Transparent"/>
                        </ControlTemplate.Resources>

                        <Border x:Name="border"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="2">
                            <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          Margin="{TemplateBinding Padding}"/>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <!-- Прямое указание цвета -->
                                <Setter TargetName="border" 
                                    Property="Background" 
                                    Value="#FF008E43"/>
                                <!-- Цвет заголовка -->
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>

                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" 
                                    Property="Background" 
                                    Value="#FF008E43"/>
                                <!-- Темнее -->
                            </Trigger>

                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" 
                                    Property="Opacity" 
                                    Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="30"
              ResizeBorderThickness="5"
              GlassFrameThickness="0"
              CornerRadius="0"/>
    </WindowChrome.WindowChrome>
    <Grid>
        <!-- Верхняя панель (кастомный заголовок) -->
        <Border Height="30" 
                Background="#FF008E43" 
                VerticalAlignment="Top"
                MouseDown="Border_MouseDown">
            <TextBlock Text="TNov - Способы прокладки" 
                       Foreground="White"
                       VerticalAlignment="Center"
                       Margin="10,0"/>
        </Border>

        <!-- Основное содержимое -->
        <Border Margin="0,30,0,0">
            <StackPanel Orientation="Vertical" HorizontalAlignment="Center">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <StackPanel Orientation="Vertical" VerticalAlignment="Center" Margin="5">

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <TextBlock Text="В параметр" Width="80" Margin="5" TextAlignment="Right" TextWrapping="Wrap" />
                            <TextBox BorderBrush="#CCCCCC" Text="{Binding sPar1}" Width="200" Margin="5" TextAlignment="Left" TextWrapping="Wrap" />
                            <TextBlock Text="записать длину со способом прокладки" Width="230" Margin="5" TextAlignment="Center" TextWrapping="Wrap" />
                            <TextBox BorderBrush="#CCCCCC" Text="{Binding sTypePar1}" Width="200" Margin="5" TextAlignment="Left" TextWrapping="Wrap" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <TextBlock Text="В параметр" Width="80" Margin="5" TextAlignment="Right" TextWrapping="Wrap" />
                            <TextBox BorderBrush="#CCCCCC" Text="{Binding sPar2}" Width="200" Margin="5" TextAlignment="Left" TextWrapping="Wrap" />
                            <TextBlock Text="записать длину со способом прокладки" Width="230" Margin="5" TextAlignment="Center" TextWrapping="Wrap" />
                            <TextBox BorderBrush="#CCCCCC" Text="{Binding sTypePar2}" Width="200" Margin="5" TextAlignment="Left" TextWrapping="Wrap" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <TextBlock Text="В параметр" Width="80" Margin="5" TextAlignment="Right" TextWrapping="Wrap" />
                            <TextBox BorderBrush="#CCCCCC" Text="{Binding sPar3}" Width="200" Margin="5" TextAlignment="Left" TextWrapping="Wrap" />
                            <TextBlock Text="записать длину со способом прокладки" Width="230" Margin="5" TextAlignment="Center" TextWrapping="Wrap" />
                            <TextBox BorderBrush="#CCCCCC" Text="{Binding sTypePar3}" Width="200" Margin="5" TextAlignment="Left" TextWrapping="Wrap" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <TextBlock Text="В параметр" Width="80" Margin="5" TextAlignment="Right" TextWrapping="Wrap" />
                            <TextBox BorderBrush="#CCCCCC" Text="{Binding sPar4}" Width="200" Margin="5" TextAlignment="Left" TextWrapping="Wrap" />
                            <TextBlock Text="записать длину со способом прокладки" Width="230" Margin="5" TextAlignment="Center" TextWrapping="Wrap" />
                            <TextBox BorderBrush="#CCCCCC" Text="{Binding sTypePar4}" Width="200" Margin="5" TextAlignment="Left" TextWrapping="Wrap" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <TextBlock Text="В параметр" Width="80" Margin="5" TextAlignment="Right" TextWrapping="Wrap" />
                            <TextBox BorderBrush="#CCCCCC" Text="{Binding sPar5}" Width="200" Margin="5" TextAlignment="Left" TextWrapping="Wrap" />
                            <TextBlock Text="записать длину со способом прокладки" Width="230" Margin="5" TextAlignment="Center" TextWrapping="Wrap" />
                            <TextBox BorderBrush="#CCCCCC" Text="{Binding sTypePar5}" Width="200" Margin="5" TextAlignment="Left" TextWrapping="Wrap" />
                        </StackPanel>

                    </StackPanel>



                </StackPanel>
                <StackPanel Orientation="Vertical" HorizontalAlignment="Center">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <TextBlock Text="Выполнить соотнесение типа трубы и способа прокладки следующим образом:" TextAlignment="Center" TextWrapping="Wrap" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Orientation="Vertical" VerticalAlignment="Center" Margin="5">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <TextBlock Text="тип трубы" Width="80" Margin="5" TextAlignment="Right" TextWrapping="Wrap" />
                        <TextBox BorderBrush="#CCCCCC" Text="{Binding pipeType1}" Width="290" Margin="5" TextAlignment="Left" TextWrapping="Wrap" />
                        <TextBlock Text="для способа прокладки" Width="140" Margin="5" TextAlignment="Center" TextWrapping="Wrap" />
                        <TextBox BorderBrush="#CCCCCC" Text="{Binding pipeWay1}" Width="200" Margin="5" TextAlignment="Left" TextWrapping="Wrap" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <TextBlock Text="тип трубы" Width="80" Margin="5" TextAlignment="Right" TextWrapping="Wrap" />
                        <TextBox BorderBrush="#CCCCCC" Text="{Binding pipeType2}" Width="290" Margin="5" TextAlignment="Left" TextWrapping="Wrap" />
                        <TextBlock Text="для способа прокладки" Width="140" Margin="5" TextAlignment="Center" TextWrapping="Wrap" />
                        <TextBox BorderBrush="#CCCCCC" Text="{Binding pipeWay2}" Width="200" Margin="5" TextAlignment="Left" TextWrapping="Wrap" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <TextBlock Text="тип трубы" Width="80" Margin="5" TextAlignment="Right" TextWrapping="Wrap" />
                        <TextBox BorderBrush="#CCCCCC" Text="{Binding pipeType3}" Width="290" Margin="5" TextAlignment="Left" TextWrapping="Wrap" />
                        <TextBlock Text="для способа прокладки" Width="140" Margin="5" TextAlignment="Center" TextWrapping="Wrap" />
                        <TextBox BorderBrush="#CCCCCC" Text="{Binding pipeWay3}" Width="200" Margin="5" TextAlignment="Left" TextWrapping="Wrap" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <TextBlock Text="тип трубы" Width="80" Margin="5" TextAlignment="Right" TextWrapping="Wrap" />
                        <TextBox BorderBrush="#CCCCCC" Text="{Binding pipeType4}" Width="290" Margin="5" TextAlignment="Left" TextWrapping="Wrap" />
                        <TextBlock Text="для способа прокладки" Width="140" Margin="5" TextAlignment="Center" TextWrapping="Wrap" />
                        <TextBox BorderBrush="#CCCCCC" Text="{Binding pipeWay4}" Width="200" Margin="5" TextAlignment="Left" TextWrapping="Wrap" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <TextBlock Text="тип трубы" Width="80" Margin="5" TextAlignment="Right" TextWrapping="Wrap" />
                        <TextBox BorderBrush="#CCCCCC" Text="{Binding pipeType5}" Width="290" Margin="5" TextAlignment="Left" TextWrapping="Wrap" />
                        <TextBlock Text="для способа прокладки" Width="140" Margin="5" TextAlignment="Center" TextWrapping="Wrap" />
                        <TextBox BorderBrush="#CCCCCC" Text="{Binding pipeWay5}" Width="200" Margin="5" TextAlignment="Left" TextWrapping="Wrap" />
                    </StackPanel>
                </StackPanel>
                <StackPanel Orientation="Vertical" HorizontalAlignment="Center">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button Style="{StaticResource CustomButtonStyle}"
    Content="Отмена" x:Name="escButton" IsCancel="True" Click="escButton_Click" Width="60" MinHeight="25" Margin="5" />
                        <Button Style="{StaticResource CustomButtonStyle}"
    Content="Применить" x:Name="acceptButton" IsDefault="True" Click="acceptButton_Click" Width="120" Margin="5"/>
                    </StackPanel>
                </StackPanel>
            </StackPanel>


        </Border>
    </Grid>
    
    
</Window>
