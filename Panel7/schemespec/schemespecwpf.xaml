<Window x:Class="TNov.schemespecwpf"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:TNov"
             mc:Ignorable="d" Height="640" Width="400"
        d:DataContext="{d:DesignInstance local:schemespecViewModel}"
            WindowStartupLocation="CenterScreen" 
            Background="DarkSeaGreen"
            Title="TNov. Группировка" ResizeMode="NoResize">
    <StackPanel VerticalAlignment="Center" Margin="5">
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
            <TextBlock Margin="5" Text="Группирование по маркам конструкций:" />
        </StackPanel>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
            <TextBlock Text="Рм" Width="50" Margin="5" TextAlignment="Center" TextWrapping="Wrap" />
            <TextBox Text="{Binding output1}" MinWidth="200" Margin="5" TextAlignment="Left" TextWrapping="Wrap" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
            <TextBlock Text="Рл" Width="50" Margin="5" TextAlignment="Center" TextWrapping="Wrap" />
            <TextBox Text="{Binding output2}" MinWidth="200" Margin="5" TextAlignment="Left" TextWrapping="Wrap" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
            <TextBlock Text="Пр" Width="50" Margin="5" TextAlignment="Center" TextWrapping="Wrap" />
            <TextBox Text="{Binding output3}" MinWidth="200" Margin="5" TextAlignment="Left" TextWrapping="Wrap" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
            <TextBlock Text="Пл" Width="50" Margin="5" TextAlignment="Center" TextWrapping="Wrap" />
            <TextBox Text="{Binding output4}" MinWidth="200" Margin="5" TextAlignment="Left" TextWrapping="Wrap" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
            <TextBlock Text="Фп" Width="50" Margin="5" TextAlignment="Center" TextWrapping="Wrap" />
            <TextBox Text="{Binding output5}" MinWidth="200" Margin="5" TextAlignment="Left" TextWrapping="Wrap" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
            <TextBlock Text="Пол/Пб" Width="50" Margin="5" TextAlignment="Center" TextWrapping="Wrap" />
            <TextBox Text="{Binding output6}" MinWidth="200" Margin="5" TextAlignment="Left" TextWrapping="Wrap" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
            <TextBlock Text="Мс" Width="50" Margin="5" TextAlignment="Center" TextWrapping="Wrap" />
            <TextBox Text="{Binding output7}" MinWidth="200" Margin="5" TextAlignment="Left" TextWrapping="Wrap" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
            <TextBlock Text="ЛК/Лк" Width="50" Margin="5" TextAlignment="Center" TextWrapping="Wrap" />
            <TextBox Text="{Binding output8}" MinWidth="200" Margin="5" TextAlignment="Left" TextWrapping="Wrap" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
            <TextBlock Text="Лм" Width="50" Margin="5" TextAlignment="Center" TextWrapping="Wrap" />
            <TextBox Text="{Binding output9}" MinWidth="200" Margin="5" TextAlignment="Left" TextWrapping="Wrap" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
            <TextBlock Text="Лп" Width="50" Margin="5" TextAlignment="Center" TextWrapping="Wrap" />
            <TextBox Text="{Binding output10}" MinWidth="200" Margin="5" TextAlignment="Left" TextWrapping="Wrap" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
            <TextBlock Text="Дж" Width="50" Margin="5" TextAlignment="Center" TextWrapping="Wrap" />
            <TextBox Text="{Binding output11}" MinWidth="200" Margin="5" TextAlignment="Left" TextWrapping="Wrap" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
            <TextBlock Text="К/Кл" Width="50" Margin="5" TextAlignment="Center" TextWrapping="Wrap" />
            <TextBox Text="{Binding output12}" MinWidth="200" Margin="5" TextAlignment="Left" TextWrapping="Wrap" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
            <TextBlock Text="Пм" Width="50" Margin="5" TextAlignment="Center" TextWrapping="Wrap" />
            <TextBox Text="{Binding output13}" MinWidth="200" Margin="5" TextAlignment="Left" TextWrapping="Wrap" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
            <TextBlock Text="Пп" Width="50" Margin="5" TextAlignment="Center" TextWrapping="Wrap" />
            <TextBox Text="{Binding output14}" MinWidth="200" Margin="5" TextAlignment="Left" TextWrapping="Wrap" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
            <TextBlock Text="Бм" Width="50" Margin="5" TextAlignment="Center" TextWrapping="Wrap" />
            <TextBox Text="{Binding output15}" MinWidth="200" Margin="5" TextAlignment="Left" TextWrapping="Wrap" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
            <TextBlock Text="Пт" Width="50" Margin="5" TextAlignment="Center" TextWrapping="Wrap" />
            <TextBox Text="{Binding output16}" MinWidth="200" Margin="5" TextAlignment="Left" TextWrapping="Wrap" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
            <TextBlock Text="Дс" Width="50" Margin="5" TextAlignment="Center" TextWrapping="Wrap" />
            <TextBox Text="{Binding output17}" MinWidth="200" Margin="5" TextAlignment="Left" TextWrapping="Wrap" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
            <TextBlock Text="Км" Width="50" Margin="5" TextAlignment="Center" TextWrapping="Wrap" />
            <TextBox Text="{Binding output18}" MinWidth="200" Margin="5" TextAlignment="Left" TextWrapping="Wrap" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
            <TextBlock Text="Вып" Width="50" Margin="5" TextAlignment="Center" TextWrapping="Wrap" />
            <TextBox Text="{Binding output19}" MinWidth="200" Margin="5" TextAlignment="Left" TextWrapping="Wrap" />
        </StackPanel>
        
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
            <Button Content="Отмена" x:Name="escButton" IsCancel="True" Click="escButton_Click" MinWidth="60" MinHeight="25" Margin="5" />
            <Button Content="Запуск" x:Name="acceptButton" IsDefault="True" Click="acceptButton_Click" MinWidth="120" Margin="5"/>
        </StackPanel>
       
    </StackPanel>
    
</Window>
